{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r3:schema:normalization-profile:0.1",
  "title": "ACCORD-02R3 frozen arm-output normalization profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "record_type", "profile_id", "profile_version", "arm_id", "accepted_output_types", "rules", "malformed_output", "oracle_input_forbidden"],
  "properties": {
    "schema_id": { "const": "urn:moirae:accord-02r3:schema:normalization-profile:0.1" },
    "schema_version": { "const": "0.1" },
    "record_type": { "const": "NORMALIZATION_PROFILE" },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string", "minLength": 1 },
    "arm_id": { "enum": ["ARM-A-DURABLE", "ARM-B-PROVIDER-OBSERVATION", "ARM-C-LIGHTWEIGHT-CLASSIFIER", "ARM-D-ACCORD-EVIDENCE"] },
    "accepted_output_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" }, "uniqueItems": true },
    "ignored_fields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "malformed_output": { "enum": ["REJECTED", "UNKNOWN_CLAIM", "NO_CLAIM"] },
    "ambiguous_output": { "enum": ["UNKNOWN_CLAIM", "CONFLICTING_CLAIM", "REJECTED"] },
    "oracle_input_forbidden": { "const": true },
    "scorer_expectation_input_forbidden": { "const": true }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "source_path", "claim_field", "mapping", "on_missing"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "claim_field": { "enum": ["occurrence_claim", "attribution_claim", "causal_claim", "indeterminacy_category", "provider_stage_claim"] },
        "mapping": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "on_missing": { "enum": ["UNKNOWN_CLAIM", "NO_CLAIM", "REJECTED"] }
      }
    }
  }
}
