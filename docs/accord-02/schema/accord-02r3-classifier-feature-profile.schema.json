{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r3:schema:classifier-feature-profile:0.1",
  "title": "ACCORD-02R3 classifier feature profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "record_type", "profile_id", "profile_version", "arm_id", "features", "forbidden_upstream_sources"],
  "properties": {
    "schema_id": { "const": "urn:moirae:accord-02r3:schema:classifier-feature-profile:0.1" },
    "schema_version": { "const": "0.1" },
    "record_type": { "const": "CLASSIFIER_FEATURE_PROFILE" },
    "profile_id": { "const": "urn:moirae:accord-02d:classifier-features:0.1" },
    "profile_version": { "const": "0.1" },
    "arm_id": { "const": "ARM-C-LIGHTWEIGHT-CLASSIFIER" },
    "features": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/feature" }, "uniqueItems": true },
    "forbidden_upstream_sources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "feature_type", "source_type", "source_path", "derivation", "allowed_for_arm_b"],
      "properties": {
        "feature_id": { "type": "string", "minLength": 1 },
        "feature_type": { "enum": ["BOOLEAN", "INTEGER", "NUMBER", "CATEGORICAL", "DURATION_MS"] },
        "source_type": { "enum": ["ATTEMPT_STATE", "EXECUTOR_STATE", "PROVIDER_STATE_READ", "RECONCILIATION_RESULT"] },
        "source_path": { "type": "string", "minLength": 1 },
        "derivation": { "enum": ["IDENTITY", "PROFILE_DEFINED_DETERMINISTIC"] },
        "allowed_for_arm_b": { "const": true }
      }
    }
  }
}
