{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5:schema:specification-package:0.1",
  "title": "ACCORD-02R5 closed specification package",
  "description": "The exact versioned normative inventory used to resolve current ACCORD-02 schemas, profiles, registries, canonicalization contracts, and validation rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "package_version", "package_schema_id", "package_schema_version", "contract_policy", "schema_contracts", "profile_contracts", "canonicalization_profiles", "role_vocabulary", "validation_rule_contract"],
  "properties": {
    "package_id": { "const": "urn:moirae:accord-02r5:specification-package" },
    "package_version": { "const": "0.1" },
    "package_schema_id": { "const": "urn:moirae:accord-02r5:schema:specification-package:0.1" },
    "package_schema_version": { "const": "0.1" },
    "contract_policy": { "const": "CLOSED_EXACT_VERSION" },
    "schema_contracts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/schemaContract" }, "uniqueItems": true },
    "profile_contracts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profileContract" }, "uniqueItems": true },
    "canonicalization_profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/canonicalizationProfileRef" }, "uniqueItems": true },
    "role_vocabulary": { "type": "array", "minItems": 1, "items": { "enum": ["ORCHESTRATOR", "DELEGATE_FIXTURE", "PROVIDER_FIXTURE", "OBSERVER_FIXTURE", "ARM-A-DURABLE", "ARM-B-PROVIDER-OBSERVATION", "ARM-C-LIGHTWEIGHT-CLASSIFIER", "ARM-D-ACCORD-EVIDENCE", "SCORER"] }, "uniqueItems": true },
    "validation_rule_contract": { "$ref": "#/$defs/validationRuleContract" },
    "package_digest": { "type": "string", "pattern": "^sha-256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "schemaContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "normative_record_types", "schema_path", "contract_kind", "allowed_bundle_types", "digest_policy"],
      "properties": {
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "normative_record_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "schema_path": { "type": "string", "pattern": "^[^/]+(?:/[^/]+)*\\.json$" },
        "contract_kind": { "enum": ["INSTANCE_RECORD_SCHEMA", "BUNDLE_SCHEMA", "RUN_RECORD_SCHEMA", "SPECIFICATION_CONTRACT_SCHEMA"] },
        "allowed_bundle_types": { "type": "array", "minItems": 1, "items": { "enum": ["VERIFIER_VALIDATION_BUNDLE", "EXPERIMENT_VALIDATION_BUNDLE", "SCORER_BUNDLE", "SPECIFICATION_PACKAGE"] }, "uniqueItems": true },
        "canonicalization_profile_id": { "type": ["string", "null"] },
        "digest_policy": { "enum": ["OPTIONAL", "REQUIRED", "FORBIDDEN"] }
      }
    },
    "profileContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_type", "profile_id", "profile_version", "schema_id", "schema_version", "profile_path", "record_type"],
      "properties": {
        "profile_type": { "enum": ["VALIDATION_RULE_PROFILE", "EXPERIMENT_PROFILE", "EXTENSION_REGISTRY", "SOURCE_SCHEMA_REGISTRY", "ROLE_VISIBILITY_PROFILE", "NORMALIZATION_PROFILE", "CLASSIFIER_FEATURE_PROFILE", "PREDICATE_APPLICABILITY_PROFILE", "ARM_INPUT_PROFILE", "AUTHORITY_PROFILE", "SETTLEMENT_PROFILE", "PROJECTION_PROFILE", "TRUST_ROOT_PROFILE", "VERIFIER_PROFILE", "CANONICALIZATION_PROFILE"] },
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_version": { "type": "string", "minLength": 1 },
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "profile_path": { "type": "string", "pattern": "^[^/]+(?:/[^/]+)*\\.json$" },
        "record_type": { "type": "string", "minLength": 1 },
        "selector": { "type": ["string", "null"] },
        "overlay_contract_id": { "type": ["string", "null"] }
      }
    },
    "canonicalizationProfileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "schema_id", "schema_version", "profile_path"],
      "properties": {
        "profile_id": { "const": "urn:moirae:accord-02r5:canonicalization:rfc8785-jcs:0.1" },
        "profile_version": { "const": "0.1" },
        "schema_id": { "const": "urn:moirae:accord-02r5:schema:canonicalization-profile:0.1" },
        "schema_version": { "const": "0.1" },
        "profile_path": { "const": "examples/accord-02r5-canonicalization-profile.json" }
      }
    },
    "validationRuleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_profile_id", "base_profile_version", "overlay_profile_id", "overlay_profile_version", "overlay_path", "dependency_graph_id", "dependency_graph_version", "dependency_graph_path", "composition"],
      "properties": {
        "base_profile_id": { "type": "string", "minLength": 1 },
        "base_profile_version": { "type": "string", "minLength": 1 },
        "overlay_profile_id": { "type": "string", "minLength": 1 },
        "overlay_profile_version": { "type": "string", "minLength": 1 },
        "overlay_path": { "type": "string", "pattern": "^[^/]+(?:/[^/]+)*\\.json$" },
        "dependency_graph_id": { "type": "string", "minLength": 1 },
        "dependency_graph_version": { "type": "string", "minLength": 1 },
        "dependency_graph_path": { "type": "string", "pattern": "^[^/]+(?:/[^/]+)*\\.json$" },
        "composition": { "const": "BASE_RULES_PLUS_EXPLICIT_OVERLAY" }
      }
    }
  }
}
