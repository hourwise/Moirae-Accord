{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02d:schema:score-record:0.2",
  "title": "ACCORD-02D scorer-only score record",
  "description": "A separate scorer artifact containing expectation, hidden oracle, normalization, and metric adjudication. It is never an arm or verifier input.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "score_record_id", "experiment_version", "experiment_run_ref", "result_record_ref", "proposition_ref", "scenario_id", "arm_id", "information_class", "system_under_test_visible", "oracle_hidden_from_system", "expectation_ref", "actual_oracle_outcome", "normalized_arm_interpretation", "metric_contributions", "categorical_failure_codes", "exclusion", "rerun", "integrity"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema_id": { "const": "urn:moirae:accord-02d:score-record" },
    "schema_version": { "const": "0.2" },
    "score_record_id": { "type": "string", "minLength": 1 },
    "experiment_version": { "type": "string", "minLength": 1 },
    "experiment_run_ref": { "$ref": "#/$defs/experimentRunReference" },
    "result_record_ref": { "$ref": "#/$defs/experimentResultReference" },
    "proposition_ref": { "$ref": "#/$defs/propositionReference" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "arm_id": { "enum": ["ARM-A-DURABLE", "ARM-B-PROVIDER-OBSERVATION", "ARM-C-LIGHTWEIGHT-CLASSIFIER", "ARM-D-ACCORD-EVIDENCE"] },
    "information_class": { "const": "SCORER_ONLY" },
    "system_under_test_visible": { "const": false },
    "oracle_hidden_from_system": { "const": true },
    "expectation_ref": { "$ref": "#/$defs/scorerExpectationReference" },
    "actual_oracle_outcome": { "$ref": "#/$defs/oracleOutcome" },
    "normalized_arm_interpretation": { "$ref": "#/$defs/normalizedInterpretation" },
    "metric_contributions": { "type": "array", "items": { "$ref": "#/$defs/metricContribution" } },
    "categorical_failure_codes": { "type": "array", "items": { "type": "string", "pattern": "^CF-[0-9]+$" }, "uniqueItems": true },
    "exclusion": { "$ref": "#/$defs/exclusion" },
    "rerun": { "$ref": "#/$defs/rerun" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "typedReference": {
      "oneOf": [
        { "$ref": "#/$defs/experimentRunReference" },
        { "$ref": "#/$defs/experimentResultReference" },
        { "$ref": "#/$defs/scorerExpectationReference" },
        { "$ref": "#/$defs/verifierRunReference" },
        { "$ref": "#/$defs/verifierResultReference" },
        { "$ref": "#/$defs/settlementResultReference" },
        { "$ref": "#/$defs/authorityResultReference" },
        { "$ref": "#/$defs/portableBundleReference" },
        { "$ref": "#/$defs/propositionReference" },
        { "$ref": "#/$defs/normalizationProfileReference" }
      ],
      "unevaluatedProperties": false
    },
    "referenceBase": {
      "type": "object",
      "required": ["record_type", "schema_id", "schema_version"],
      "properties": {
        "record_type": { "type": "string", "minLength": 1 },
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "content_digest": { "type": "string", "pattern": "^sha-256:[0-9a-f]{64}$" }
      }
    },
    "experimentRunReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "EXPERIMENT_RUN" }, "experiment_run_id": { "type": "string", "minLength": 1 } }, "required": ["experiment_run_id"] }], "unevaluatedProperties": false },
    "experimentResultReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "EXPERIMENT_RESULT_RECORD" }, "experiment_result_id": { "type": "string", "minLength": 1 } }, "required": ["experiment_result_id"] }], "unevaluatedProperties": false },
    "scorerExpectationReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "SCORER_EXPECTATION" }, "scorer_expectation_id": { "type": "string", "minLength": 1 } }, "required": ["scorer_expectation_id"] }], "unevaluatedProperties": false },
    "verifierRunReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "VERIFIER_RUN" }, "verifier_run_id": { "type": "string", "minLength": 1 } }, "required": ["verifier_run_id"] }], "unevaluatedProperties": false },
    "verifierResultReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "VERIFIER_RESULT" }, "verifier_result_id": { "type": "string", "minLength": 1 } }, "required": ["verifier_result_id"] }], "unevaluatedProperties": false },
    "settlementResultReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "SETTLEMENT_RESULT" }, "settlement_result_id": { "type": "string", "minLength": 1 } }, "required": ["settlement_result_id"] }], "unevaluatedProperties": false },
    "authorityResultReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "AUTHORITY_ANALYSIS_RESULT" }, "authority_analysis_result_id": { "type": "string", "minLength": 1 } }, "required": ["authority_analysis_result_id"] }], "unevaluatedProperties": false },
    "portableBundleReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "PORTABLE_BUNDLE" }, "portable_bundle_id": { "type": "string", "minLength": 1 } }, "required": ["portable_bundle_id"] }], "unevaluatedProperties": false },
    "propositionReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "effect_proposition" }, "proposition_id": { "type": "string", "minLength": 1 }, "schema_id": { "const": "urn:moirae:accord-02r2:effect-proposition" }, "schema_version": { "const": "0.1" } }, "required": ["proposition_id"] }], "unevaluatedProperties": false },
    "normalizationProfileReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "NORMALIZATION_PROFILE" }, "normalization_profile_id": { "type": "string", "minLength": 1 } }, "required": ["normalization_profile_id"] }], "unevaluatedProperties": false },
    "oracleOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "predicate_id", "stage", "effect_occurrence", "duplicate_count", "recipient", "resource", "attempt_linkage", "event_sequence"],
      "properties": {
        "effect_id": { "type": "string", "minLength": 1 },
        "predicate_id": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "effect_occurrence": { "enum": ["OCCURS", "DOES_NOT_OCCUR", "DUPLICATE_OCCURS", "UNRESOLVED_TO_SYSTEM", "PARTIAL_STAGE"] },
        "duplicate_count": { "type": "integer", "minimum": 0 },
        "recipient": { "type": ["string", "null"] },
        "resource": { "type": ["string", "null"] },
        "attempt_linkage": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "event_sequence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "normalizedInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_result_ref", "adapter_profile_ref", "occurrence_claim", "attribution_claim", "causal_claim", "indeterminacy_category", "accord_projection_kind"],
      "properties": {
        "source_result_ref": { "$ref": "#/$defs/experimentResultReference" },
        "adapter_profile_ref": { "$ref": "#/$defs/normalizationProfileReference" },
        "occurrence_claim": { "enum": ["POSITIVE", "NEGATIVE", "PARTIAL", "CONFLICTING", "UNKNOWN", "REJECTED", "NOT_REPORTED"] },
        "attribution_claim": { "enum": ["SPECIFIC_ATTEMPT", "ONE_OR_MORE_ATTEMPTS", "UNKNOWN", "CONFLICTING", "NOT_REPORTED"] },
        "causal_claim": { "enum": ["SPECIFIC_ATTEMPT", "ONE_OR_MORE_ATTEMPTS", "EFFECT_BOUND", "EXTERNAL_STATE_ONLY", "UNKNOWN", "CONFLICTING", "NOT_REPORTED"] },
        "indeterminacy_category": { "enum": ["NONE", "PENDING", "TERMINAL", "INSUFFICIENT", "STALE", "INADMISSIBLE", "PROFILE_INCOMPATIBLE", "CONFLICTING", "POSSIBLE_DUPLICATE"] },
        "accord_projection_kind": { "enum": ["VERIFIED", "CORROBORATED", "NO_EFFECT_OBSERVED", "UNKNOWN_PENDING", "UNKNOWN_TERMINAL", "REJECTED", "NOT_APPLICABLE"] }
      }
    },
    "metricContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "numerator_increment", "denominator_increment", "reason"],
      "properties": {
        "metric_id": { "type": "string", "minLength": 1 },
        "numerator_increment": { "type": "integer", "minimum": 0 },
        "denominator_increment": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code", "evidence_refs", "rerun_permitted"],
      "properties": {
        "status": { "enum": ["NOT_EXCLUDED", "EXCLUDED"] },
        "reason_code": { "enum": ["NONE", "FIXTURE_CORRUPTION", "HARNESS_DEFECT_PREVENTED_START", "ORACLE_CORRUPTION", "MACHINE_FAILURE_BEFORE_START"] },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "rerun_permitted": { "type": "boolean" }
      }
    },
    "rerun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "category", "original_result_preserved"],
      "properties": {
        "status": { "enum": ["NO_RERUN", "RERUN_PLANNED", "RERUN_COMPLETED"] },
        "category": { "enum": ["NONE", "NEVER_STARTED", "HARNESS_FAILURE", "PLANNED_REPLICATE", "POST_OUTCOME_REPEAT"] },
        "original_result_preserved": { "const": true },
        "original_result_ref": { "$ref": "#/$defs/typedReference" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "canonicalization", "digest_algorithm"],
      "properties": {
        "content_digest": { "type": "string", "pattern": "^sha-256:[0-9a-f]{64}$" },
        "canonicalization": { "enum": ["RFC8785_JCS", "PROFILE_DEFINED_CANONICAL_FORM"] },
        "digest_algorithm": { "enum": ["SHA-256", "PROFILE_DEFINED"] }
      }
    }
  }
}
