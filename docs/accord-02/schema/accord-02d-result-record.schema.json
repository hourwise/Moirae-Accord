{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02d:schema:result-record:0.2",
  "title": "ACCORD-02D future system-visible experiment result record",
  "description": "Schema for the run-facing result record. Scorer-only expectations, oracle facts, normalization, and adjudication are stored in the separate ACCORD-02D score-record schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "result_record_id",
    "experiment_version",
    "scenario_id",
    "experiment_run_id",
    "proposition_ref",
    "seed",
    "arm_id",
    "timestamps",
    "configuration_digest",
    "system_visible",
    "lineage",
    "visibility_boundary",
    "integrity"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:moirae:accord-02d:result-record"
    },
    "schema_version": {
      "const": "0.2"
    },
    "result_record_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_version": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_run_id": {
      "type": "string",
      "minLength": 1
    },
    "proposition_ref": {
      "$ref": "#/$defs/propositionReference"
    },
    "seed": {
      "type": "integer"
    },
    "arm_id": {
      "enum": [
        "ARM-A-DURABLE",
        "ARM-B-PROVIDER-OBSERVATION",
        "ARM-C-LIGHTWEIGHT-CLASSIFIER",
        "ARM-D-ACCORD-EVIDENCE"
      ]
    },
    "timestamps": {
      "$ref": "#/$defs/timestamps"
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^sha-256:[0-9a-f]{64}$"
    },
    "topology_id": {
      "type": "string",
      "minLength": 1
    },
    "effect_surface_id": {
      "enum": [
        "S1_STRONG_RECEIPT",
        "S2_WEAK_AMBIGUOUS",
        "S3_STAGED_OPTIONAL"
      ]
    },
    "transport_id": {
      "enum": [
        "T1_LOCAL_NATIVE",
        "T2_MCP_SHAPED",
        "T3_A2A_SHAPED"
      ]
    },
    "delegate_behavior_id": {
      "enum": [
        "HONEST",
        "LYING_SUCCESS",
        "LYING_FAILURE",
        "PARTIALLY_LYING",
        "FAULTY_NON_MALICIOUS"
      ]
    },
    "fault_injection": {
      "$ref": "#/$defs/faultInjection"
    },
    "idempotency_condition_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "system_visible": {
      "$ref": "#/$defs/systemVisible"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "visibility_boundary": {
      "$ref": "#/$defs/visibilityBoundary"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$defs": {
    "typedReference": {
      "oneOf": [
        { "$ref": "#/$defs/experimentRunReference" },
        { "$ref": "#/$defs/experimentResultReference" },
        { "$ref": "#/$defs/verifierRunReference" },
        { "$ref": "#/$defs/verifierResultReference" },
        { "$ref": "#/$defs/settlementResultReference" },
        { "$ref": "#/$defs/authorityResultReference" },
        { "$ref": "#/$defs/portableBundleReference" },
        { "$ref": "#/$defs/portableRecordReference" },
        { "$ref": "#/$defs/attemptReference" },
        { "$ref": "#/$defs/evidenceReference" },
        { "$ref": "#/$defs/armInputManifestReference" },
        { "$ref": "#/$defs/armInputProfileReference" },
        { "$ref": "#/$defs/classifierFeatureReference" },
        { "$ref": "#/$defs/mappingProfileReference" },
        { "$ref": "#/$defs/propositionReference" },
        { "$ref": "#/$defs/normalizationProfileReference" }
      ],
      "unevaluatedProperties": false
    },
    "referenceBase": {
      "type": "object",
      "required": ["record_type", "schema_id", "schema_version"],
      "properties": {
        "record_type": { "type": "string", "minLength": 1 },
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "content_digest": { "type": "string", "pattern": "^sha-256:[0-9a-f]{64}$" }
      }
    },
    "experimentRunReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "EXPERIMENT_RUN" }, "experiment_run_id": { "type": "string", "minLength": 1 } }, "required": ["experiment_run_id"] }], "unevaluatedProperties": false },
    "experimentResultReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "EXPERIMENT_RESULT_RECORD" }, "experiment_result_id": { "type": "string", "minLength": 1 } }, "required": ["experiment_result_id"] }], "unevaluatedProperties": false },
    "verifierRunReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "VERIFIER_RUN" }, "verifier_run_id": { "type": "string", "minLength": 1 } }, "required": ["verifier_run_id"] }], "unevaluatedProperties": false },
    "verifierResultReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "VERIFIER_RESULT" }, "verifier_result_id": { "type": "string", "minLength": 1 } }, "required": ["verifier_result_id"] }], "unevaluatedProperties": false },
    "settlementResultReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "SETTLEMENT_RESULT" }, "settlement_result_id": { "type": "string", "minLength": 1 } }, "required": ["settlement_result_id"] }], "unevaluatedProperties": false },
    "authorityResultReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "AUTHORITY_ANALYSIS_RESULT" }, "authority_analysis_result_id": { "type": "string", "minLength": 1 } }, "required": ["authority_analysis_result_id"] }], "unevaluatedProperties": false },
    "portableBundleReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "PORTABLE_BUNDLE" }, "portable_bundle_id": { "type": "string", "minLength": 1 } }, "required": ["portable_bundle_id"] }], "unevaluatedProperties": false },
    "portableRecordReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "PORTABLE_RECORD" }, "portable_record_id": { "type": "string", "minLength": 1 } }, "required": ["portable_record_id"] }], "unevaluatedProperties": false },
    "attemptReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "ATTEMPT_RECORD" }, "attempt_id": { "type": "string", "minLength": 1 } }, "required": ["attempt_id"] }], "unevaluatedProperties": false },
    "evidenceReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "EVIDENCE_ARTIFACT" }, "evidence_id": { "type": "string", "minLength": 1 } }, "required": ["evidence_id"] }], "unevaluatedProperties": false },
    "armInputManifestReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "ARM_INPUT_MANIFEST" }, "arm_input_manifest_id": { "type": "string", "minLength": 1 } }, "required": ["arm_input_manifest_id"] }], "unevaluatedProperties": false },
    "armInputProfileReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "ARM_INPUT_PROFILE" }, "arm_input_profile_id": { "type": "string", "minLength": 1 } }, "required": ["arm_input_profile_id"] }], "unevaluatedProperties": false },
    "classifierFeatureReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "CLASSIFIER_FEATURE" }, "classifier_feature_id": { "type": "string", "minLength": 1 } }, "required": ["classifier_feature_id"] }], "unevaluatedProperties": false },
    "mappingProfileReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "MAPPING_PROFILE" }, "mapping_profile_id": { "type": "string", "minLength": 1 } }, "required": ["mapping_profile_id"] }], "unevaluatedProperties": false },
    "propositionReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "effect_proposition" }, "proposition_id": { "type": "string", "minLength": 1 }, "schema_id": { "const": "urn:moirae:accord-02r2:effect-proposition" }, "schema_version": { "const": "0.1" } }, "required": ["proposition_id"] }], "unevaluatedProperties": false },
    "normalizationProfileReference": { "allOf": [{ "$ref": "#/$defs/referenceBase" }, { "type": "object", "properties": { "record_type": { "const": "NORMALIZATION_PROFILE" }, "normalization_profile_id": { "type": "string", "minLength": 1 } }, "required": ["normalization_profile_id"] }], "unevaluatedProperties": false },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_run_ref", "result_record_ref", "verifier_run_ref", "verifier_result_ref", "authority_result_ref", "settlement_result_ref"],
      "properties": {
        "experiment_run_ref": { "$ref": "#/$defs/experimentRunReference" },
        "result_record_ref": { "$ref": "#/$defs/experimentResultReference" },
        "verifier_run_ref": { "oneOf": [{ "$ref": "#/$defs/verifierRunReference" }, { "type": "null" }] },
        "verifier_result_ref": { "oneOf": [{ "$ref": "#/$defs/verifierResultReference" }, { "type": "null" }] },
        "authority_result_ref": { "oneOf": [{ "$ref": "#/$defs/authorityResultReference" }, { "type": "null" }] },
        "settlement_result_ref": { "oneOf": [{ "$ref": "#/$defs/settlementResultReference" }, { "type": "null" }] }
      }
    },
    "effectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "predicate_id", "stage", "action", "target_binding", "resource_binding", "recipient_binding", "provider_binding", "external_identifier_binding"],
      "properties": {
        "effect_id": { "type": "string", "minLength": 1 },
        "predicate_id": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "target_binding": { "$ref": "#/$defs/bindingSlot" },
        "resource_binding": { "$ref": "#/$defs/bindingSlot" },
        "recipient_binding": { "$ref": "#/$defs/bindingSlot" },
        "provider_binding": { "$ref": "#/$defs/bindingSlot" },
        "external_identifier_binding": { "$ref": "#/$defs/bindingSlot" }
      }
    },
    "bindingSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["BOUND", "NOT_APPLICABLE", "UNKNOWN"] },
        "value": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "BOUND" } } }, "then": { "required": ["value"] } },
        { "if": { "properties": { "status": { "enum": ["NOT_APPLICABLE", "UNKNOWN"] } } }, "then": { "not": { "required": ["value"] } } }
      ]
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_started_at",
        "run_finished_at"
      ],
      "properties": {
        "run_started_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "dispatch_at": {
          "type": "string",
          "format": "date-time"
        },
        "provider_event_at": {
          "type": "string",
          "format": "date-time"
        },
        "observation_at": {
          "type": "string",
          "format": "date-time"
        },
        "verification_at": {
          "type": "string",
          "format": "date-time"
        },
        "scoring_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "faultInjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fault_ids",
        "fixture_identity",
        "planned",
        "observed",
        "injection_record_ref"
      ],
      "properties": {
        "fault_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "fixture_identity": {
          "type": "string",
          "minLength": 1
        },
        "planned": {
          "type": "boolean"
        },
        "observed": {
          "type": "boolean"
        },
        "injection_record_ref": { "$ref": "#/$defs/typedReference" },
        "delivery_point": {
          "type": "string"
        },
        "deviation_reason": {
          "type": "string"
        }
      }
    },
    "systemVisible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_input_manifest_ref",
        "task_effect_identities",
        "attempts",
        "observed_evidence",
        "authority_result",
        "raw_arm_output",
        "duplicate_effect_report",
        "escalation",
        "verifier_reproducibility"
      ],
      "properties": {
        "arm_input_manifest_ref": {
          "$ref": "#/$defs/armInputManifestReference"
        },
        "task_effect_identities": {
          "$ref": "#/$defs/taskEffectIdentities"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "observed_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observedEvidence"
          }
        },
        "authority_result": {
          "$ref": "#/$defs/authorityResult"
        },
        "accord_result": {
          "$ref": "#/$defs/accordResult"
        },
        "raw_arm_output": {
          "$ref": "#/$defs/rawArmOutput"
        },
        "classifier_output": {
          "$ref": "#/$defs/classifierOutput"
        },
        "duplicate_effect_report": {
          "$ref": "#/$defs/duplicateReport"
        },
        "escalation": {
          "$ref": "#/$defs/escalation"
        },
        "verifier_reproducibility": {
          "$ref": "#/$defs/verifierReproducibility"
        }
      }
    },
    "taskEffectIdentities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "effect_id",
        "proposition_ref",
        "predicate_binding",
        "record_refs"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1
        },
        "grant_id": {
          "type": "string",
          "minLength": 1
        },
        "intent_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "delegation_id": {
          "type": "string",
          "minLength": 1
        },
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "proposition_ref": {
          "$ref": "#/$defs/propositionReference"
        },
        "predicate_binding": {
          "$ref": "#/$defs/effectBinding"
        },
        "record_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/typedReference"
          },
          "uniqueItems": true
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "effect_id",
        "proposition_ref",
        "attempt_ordinal",
        "dispatch_state",
        "effect_binding",
        "record_ref"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "proposition_ref": {
          "$ref": "#/$defs/propositionReference"
        },
        "attempt_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "dispatch_state": {
          "enum": [
            "NOT_DISPATCHED",
            "DISPATCHED",
            "ACKNOWLEDGEMENT_UNCERTAIN",
            "FAILED",
            "COMPLETED",
            "UNKNOWN"
          ]
        },
        "effect_binding": {
          "$ref": "#/$defs/effectBinding"
        },
        "provider_operation_id": {
          "type": "string"
        },
        "idempotency_key_digest": {
          "type": "string"
        },
        "record_ref": {
          "$ref": "#/$defs/typedReference"
        }
      }
    },
    "observedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_class",
        "effect_id",
        "proposition_ref",
        "observer_principal_id",
        "issuer_principal_id",
        "trust_root_id",
        "profile_id",
        "visibility",
        "effect_binding",
        "record_ref"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "type": "string",
          "minLength": 1
        },
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "proposition_ref": {
          "$ref": "#/$defs/propositionReference"
        },
        "effect_binding": {
          "$ref": "#/$defs/effectBinding"
        },
        "attempt_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "observer_principal_id": {
          "type": "string",
          "minLength": 1
        },
        "issuer_principal_id": {
          "type": "string",
          "minLength": 1
        },
        "trust_root_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "const": "SYSTEM_VISIBLE"
        },
        "event_time": {
          "type": "string",
          "format": "date-time"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "record_ref": {
          "$ref": "#/$defs/typedReference"
        }
      }
    },
    "authorityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_relation",
        "effective_authority",
        "event_time_validity",
        "profile_id",
        "source_record_refs",
        "effect_axis_separate"
      ],
      "properties": {
        "grant_relation": {
          "$ref": "#/$defs/grantRelation"
        },
        "effective_authority": {
          "$ref": "#/$defs/effectiveAuthority"
        },
        "event_time_validity": {
          "$ref": "#/$defs/eventTimeValidity"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "source_record_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typedReference"
          },
          "uniqueItems": true
        },
        "effect_axis_separate": {
          "const": true
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "grantRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_relation",
        "comparison_profile_id",
        "source_result_ref"
      ],
      "properties": {
        "aggregate_relation": {
          "enum": [
            "ATTENUATED",
            "EQUIVALENT",
            "WIDENED",
            "INCOMPARABLE",
            "UNSUPPORTED",
            "UNKNOWN"
          ]
        },
        "comparison_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "source_result_ref": {
          "$ref": "#/$defs/typedReference"
        },
        "unknown_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "widening_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "effectiveAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "composition_profile_id",
        "source_result_ref"
      ],
      "properties": {
        "state": {
          "enum": [
            "CONTAINED",
            "POSSIBLE_WIDENING",
            "WIDENED",
            "UNKNOWN",
            "UNSUPPORTED",
            "CONFLICTING"
          ]
        },
        "composition_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "source_result_ref": {
          "$ref": "#/$defs/typedReference"
        },
        "active_grant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "possible_widening_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unresolved_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "eventTimeValidity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_derivation",
        "at_admission",
        "at_dispatch",
        "at_occurrence",
        "at_verification"
      ],
      "properties": {
        "at_derivation": {
          "$ref": "#/$defs/authorityValidity"
        },
        "at_admission": {
          "$ref": "#/$defs/authorityValidity"
        },
        "at_dispatch": {
          "$ref": "#/$defs/authorityValidity"
        },
        "at_occurrence": {
          "$ref": "#/$defs/authorityValidity"
        },
        "at_verification": {
          "$ref": "#/$defs/authorityValidity"
        }
      }
    },
    "authorityValidity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "known_at_verification",
        "basis_record_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "AUTHORIZED",
            "INVALID_AUTHORITY",
            "UNKNOWN_AUTHORITY",
            "UNSUPPORTED_AUTHORITY",
            "CONFLICTING_AUTHORITY",
            "NOT_EVALUATED"
          ]
        },
        "known_at_verification": {
          "type": "boolean"
        },
        "basis_record_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typedReference"
          },
          "uniqueItems": true
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "accordResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_c_result_ref",
        "native_axes",
        "mapping_profile_ref",
        "proposition_ref"
      ],
      "properties": {
        "native_c_result_ref": {
          "$ref": "#/$defs/settlementResultReference"
        },
        "native_axes": {
          "$ref": "#/$defs/nativeSettlementAxes"
        },
        "mapping_profile_ref": {
          "$ref": "#/$defs/mappingProfileReference"
        },
        "proposition_ref": {
          "$ref": "#/$defs/propositionReference"
        },
        "a_projection": {
          "$ref": "#/$defs/aProjection"
        }
      }
    },
    "nativeSettlementAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "occurrence",
        "attribution",
        "causality",
        "completeness",
        "sufficiency",
        "freshness",
        "duplication",
        "finality",
        "profile_compatibility"
      ],
      "properties": {
        "overall": {
          "enum": [
            "EFFECT_SUPPORTED",
            "NON_OCCURRENCE_SUPPORTED",
            "PARTIAL_EFFECT",
            "CONFLICTING_EVIDENCE",
            "UNRESOLVED",
            "INADMISSIBLE_EVIDENCE",
            "STALE_EVIDENCE",
            "PROFILE_INCOMPATIBLE",
            "UNKNOWN",
            "POSSIBLE_DUPLICATE_EFFECT"
          ]
        },
        "occurrence": {
          "enum": [
            "OCCURRENCE_SUPPORTED",
            "NON_OCCURRENCE_SUPPORTED",
            "PARTIAL_EFFECT",
            "CONFLICTING_EVIDENCE",
            "INSUFFICIENT_EVIDENCE",
            "INADMISSIBLE_EVIDENCE",
            "STALE_EVIDENCE",
            "UNKNOWN"
          ]
        },
        "attribution": {
          "enum": [
            "ATTRIBUTED_TO_SPECIFIC_ATTEMPT",
            "ATTRIBUTED_TO_ONE_OR_MORE_ATTEMPTS",
            "ATTRIBUTION_UNKNOWN",
            "ATTRIBUTION_CONFLICTING",
            "INADMISSIBLE",
            "NOT_APPLICABLE"
          ]
        },
        "causality": {
          "enum": [
            "SPECIFIC_ATTEMPT_SUPPORTED",
            "CAUSED_BY_ONE_OR_MORE_ATTEMPTS",
            "EFFECT_BOUND",
            "EXTERNAL_STATE_ONLY",
            "CAUSATION_UNKNOWN",
            "CAUSATION_CONFLICTING",
            "NOT_ASSESSED"
          ]
        },
        "completeness": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "sufficiency": {
          "enum": [
            "SUFFICIENT",
            "INSUFFICIENT",
            "INADMISSIBLE",
            "STALE",
            "CONFLICTING",
            "PROFILE_INCOMPATIBLE",
            "UNKNOWN"
          ]
        },
        "freshness": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "duplication": {
          "enum": [
            "NONE_SUPPORTED",
            "POSSIBLE_DUPLICATE",
            "DUPLICATE_SUPPORTED",
            "DISTINCT_OCCURRENCES_SUPPORTED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "finality": {
          "enum": [
            "PROVISIONAL",
            "REOPENABLE",
            "FINAL_UNDER_PROFILE",
            "REOPENED",
            "NOT_FINAL"
          ]
        },
        "profile_compatibility": {
          "enum": [
            "COMPATIBLE",
            "INCOMPATIBLE",
            "UNKNOWN",
            "NOT_EVALUATED"
          ]
        }
      }
    },
    "aProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "projection_profile_id",
        "native_result_ref",
        "proposition_ref",
        "effect_id",
        "predicate_id",
        "stage",
        "target_binding"
      ],
      "properties": {
        "kind": {
          "enum": [
            "VERIFIED",
            "CORROBORATED",
            "NO_EFFECT_OBSERVED",
            "UNKNOWN_PENDING",
            "UNKNOWN_TERMINAL",
            "REJECTED"
          ]
        },
        "projection_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "native_result_ref": {
          "$ref": "#/$defs/typedReference"
        },
        "proposition_ref": {
          "$ref": "#/$defs/propositionReference"
        },
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "target_binding": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "type": "string",
          "minLength": 1
        },
        "observer_principal_id": {
          "type": "string",
          "minLength": 1
        },
        "trust_root_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "read_semantics": {
          "type": "string",
          "minLength": 1
        },
        "retry_until": {
          "type": "string",
          "format": "date-time"
        },
        "finality_scope": {
          "enum": [
            "PROFILE_ONLY",
            "NAMED_INTERVAL_AND_SCOPE",
            "NEVER_UNIVERSAL"
          ]
        }
      }
    },
    "rawArmOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "arm_id",
        "visibility",
        "output_type",
        "payload_schema_id",
        "payload_digest",
        "captured_at",
        "untrusted_system_output"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "arm_id": {
          "enum": [
            "ARM-A-DURABLE",
            "ARM-B-PROVIDER-OBSERVATION",
            "ARM-C-LIGHTWEIGHT-CLASSIFIER",
            "ARM-D-ACCORD-EVIDENCE"
          ]
        },
        "visibility": {
          "const": "SYSTEM_VISIBLE"
        },
        "output_type": {
          "enum": ["DURABLE_BASELINE_OUTPUT", "PROVIDER_OBSERVATION_OUTPUT", "CLASSIFIER_OUTPUT", "ACCORD_VERIFIER_OUTPUT", "ARM_SPECIFIC_UNTRUSTED_OUTPUT"]
        },
        "payload_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^sha-256:[0-9a-f]{64}$"
        },
        "payload_ref": {
          "$ref": "#/$defs/typedReference"
        },
        "payload": {
          "type": ["object", "array", "string", "number", "boolean", "null"]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "untrusted_system_output": {
          "const": true
        }
      },
      "oneOf": [
        { "required": ["payload"], "not": { "required": ["payload_ref"] } },
        { "required": ["payload_ref"], "not": { "required": ["payload"] } }
      ]
    },
    "classifierOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "feature_refs",
