            "enum": [
              "CONFLICTING_EVIDENCE",
              "UNKNOWN_TERMINAL",
              "HIGH_VALUE_AUTHORITY_AMBIGUITY",
              "DUPLICATE_RISK",
              "UNSUPPORTED_PROFILE",
              "ATTRIBUTION_CONFLICT",
              "INFRASTRUCTURE_REVIEW"
