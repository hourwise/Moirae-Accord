    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "triggers",
        "human_saw_hidden_oracle",
        "disposition"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "triggers": {
          "type": "array",
