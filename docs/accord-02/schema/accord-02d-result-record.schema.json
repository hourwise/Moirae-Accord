          "items": { "$ref": "#/$defs/typedReference" },
          "uniqueItems": true
        },
        "private_state_used": {
          "const": false
        },
        "independent_reproduction_status": {
          "enum": [
            "NOT_ATTEMPTED",
            "REPRODUCED",
            "NOT_REPRODUCED",
            "INCOMPATIBLE_PROFILE",
            "MISSING_MATERIAL"
          ]
        },
        "failure_categories": {
          "type": "array",
          "items": {
            "enum": [
              "MISSING_LINK",
              "HIDDEN_STATE_DEPENDENCY",
              "UNSUPPORTED_EXTENSION",
              "DIGEST_MISMATCH",
              "NONDETERMINISTIC_RESULT",
              "PROFILE_INCOMPATIBLE",
              "DETACHED_MATERIAL_UNAVAILABLE",
              "LABEL_AXIS_MISMATCH"
            ]
          },
          "uniqueItems": true
        },
        "reproduction_run_ref": {
          "$ref": "#/$defs/typedReference"
        }
      }
    },
    "visibilityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
