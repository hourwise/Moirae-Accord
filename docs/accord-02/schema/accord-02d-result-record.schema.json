      ],
      "properties": {
        "system_visible_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scorer_only_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "oracle_hidden_from_system": {
          "const": true
        },
        "scorer_is_not_portable_verifier": {
          "const": true
        },
        "arm_allowlist_profile_ref": {
          "$ref": "#/$defs/armInputProfileReference"
        },
        "arm_manifest_is_sanitized": {
          "const": true
        },
        "expected_result_fields_absent": {
          "const": true
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_digest",
        "canonicalization",
        "digest_algorithm"
      ],
      "properties": {
        "content_digest": {
          "type": "string",
          "pattern": "^sha-256:[0-9a-f]{64}$"
        },
        "canonicalization": {
          "enum": [
            "RFC8785_JCS",
            "PROFILE_DEFINED_CANONICAL_FORM"
          ]
        },
        "digest_algorithm": {
          "enum": [
            "SHA-256",
            "PROFILE_DEFINED"
          ]
        }
      }
    }
