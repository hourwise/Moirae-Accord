{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02d:schema:arm-input-profile:0.2",
  "title": "ACCORD-02D per-arm input allowlist catalog",
  "description": "Closed structural contract for the information each experimental arm may receive. It is not a scenario oracle and does not contain expected outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_id",
    "schema_version",
    "information_class",
    "system_under_test_visible",
    "oracle_fields_forbidden",
    "expected_result_fields_forbidden",
    "source_schema_registry_ref",
    "role_visibility_profile_ref",
    "validation_rule_profile_ref",
    "profiles"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema_id": { "const": "urn:moirae:accord-02d:arm-input-profile" },
    "schema_version": { "const": "0.2" },
    "information_class": { "const": "ARM_INPUT_ALLOWLIST" },
    "system_under_test_visible": { "const": true },
    "oracle_fields_forbidden": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "expected_result_fields_forbidden": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "source_schema_registry_ref": { "$ref": "#/$defs/profileReference" },
    "role_visibility_profile_ref": { "$ref": "#/$defs/profileReference" },
    "validation_rule_profile_ref": { "$ref": "#/$defs/profileReference" },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/armProfile" }
    }
  },
  "allOf": [
    { "properties": { "profiles": { "contains": { "type": "object", "properties": { "arm_id": { "const": "ARM-A-DURABLE" } }, "required": ["arm_id"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "profiles": { "contains": { "type": "object", "properties": { "arm_id": { "const": "ARM-B-PROVIDER-OBSERVATION" } }, "required": ["arm_id"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "profiles": { "contains": { "type": "object", "properties": { "arm_id": { "const": "ARM-C-LIGHTWEIGHT-CLASSIFIER" } }, "required": ["arm_id"] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "profiles": { "contains": { "type": "object", "properties": { "arm_id": { "const": "ARM-D-ACCORD-EVIDENCE" } }, "required": ["arm_id"] }, "minContains": 1, "maxContains": 1 } } }
  ],
  "$defs": {
    "armProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_id",
        "input_profile_id",
        "allowed_fields",
        "forbidden_fields",
        "allowed_evidence_sources",
        "authority_information",
        "provider_state_information",
        "accord_specific_semantics",
        "trust_roots_visible",
        "evidence_profile_visible",
        "classifier_input_fields",
        "scenario_catalog_directly_consumable",
        "allowed_source_types",
        "forbidden_source_types",
        "source_schema_registry_ref",
        "role_visibility_profile_ref",
        "validation_rule_profile_ref",
        "profile_closed"
      ],
      "properties": {
        "arm_id": { "enum": ["ARM-A-DURABLE", "ARM-B-PROVIDER-OBSERVATION", "ARM-C-LIGHTWEIGHT-CLASSIFIER", "ARM-D-ACCORD-EVIDENCE"] },
        "input_profile_id": { "type": "string", "minLength": 1 },
        "allowed_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fieldRule" },
          "uniqueItems": true
        },
        "forbidden_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/forbiddenField" },
          "uniqueItems": true
        },
        "allowed_evidence_sources": {
          "type": "array",
          "items": { "enum": ["NONE", "ORDINARY_EXECUTOR_STATE", "TRANSPORT_ACKNOWLEDGEMENT", "PROVIDER_ACCEPTANCE", "PROVIDER_STATE_READ", "RECONCILIATION", "PORTABLE_RECORD_BUNDLE", "SUPPLIED_EVIDENCE_ARTIFACTS"] },
          "uniqueItems": true
        },
        "authority_information": {
          "type": "array",
          "items": { "enum": ["ORDINARY_ADMISSION_STATE", "DECLARED_GRANT_RECORDS", "PORTABLE_AUTHORITY_BUNDLE", "AUTHORITY_PROFILE", "NONE"] },
          "uniqueItems": true
        },
        "provider_state_information": {
          "type": "array",
          "items": { "enum": ["NONE", "ACCEPTANCE_ONLY", "ORDINARY_STATE_READ", "RECONCILIATION_READ", "SUPPLIED_EFFECT_EVIDENCE"] },
          "uniqueItems": true
        },
        "accord_specific_semantics": {
          "type": "array",
          "items": { "enum": ["NONE", "PORTABLE_IDENTITIES", "EVIDENCE_PROFILE", "TRUST_ROOTS", "ACCORD_02C_NATIVE_SETTLEMENT", "ACCORD_02A_PROJECTED_RESULT", "ACCORD_02B_ANALYSIS"] },
          "uniqueItems": true
        },
        "trust_roots_visible": { "type": "boolean" },
        "evidence_profile_visible": { "type": "boolean" },
        "classifier_input_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "scenario_catalog_directly_consumable": { "const": false },
        "allowed_source_types": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["DURABLE_TASK_STATE", "ATTEMPT_STATE", "EXECUTOR_STATE", "ADMISSION_STATE", "DELEGATE_REPORT", "PROVIDER_STATE_READ", "RECONCILIATION_RESULT", "CLASSIFIER_FEATURE", "PORTABLE_RECORD_BUNDLE", "AUTHORITY_PROFILE", "SETTLEMENT_PROFILE", "TRUST_ROOT_PROFILE", "DETACHED_EVIDENCE"] },
          "uniqueItems": true
        },
        "forbidden_source_types": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["SCORER_EXPECTATION", "ORACLE_RECORD", "SCORE_RECORD", "NATIVE_SETTLEMENT_RESULT", "PROJECTED_VERIFIER_RESULT", "PRIVATE_ACCORD_STATE"] },
          "uniqueItems": true
        },
        "source_schema_registry_ref": { "$ref": "#/$defs/profileReference" },
        "role_visibility_profile_ref": { "$ref": "#/$defs/profileReference" },
        "validation_rule_profile_ref": { "$ref": "#/$defs/profileReference" },
        "classifier_feature_profile_ref": { "$ref": "#/$defs/profileReference" },
        "profile_closed": { "const": true }
      },
      "allOf": [
        { "if": { "properties": { "arm_id": { "const": "ARM-A-DURABLE" } }, "required": ["arm_id"] }, "then": { "properties": { "input_profile_id": { "const": "urn:moirae:accord-02d:arm-input:durable:0.1" } } } },
        { "if": { "properties": { "arm_id": { "const": "ARM-B-PROVIDER-OBSERVATION" } }, "required": ["arm_id"] }, "then": { "properties": { "input_profile_id": { "const": "urn:moirae:accord-02d:arm-input:provider-observation:0.1" } } } },
        { "if": { "properties": { "arm_id": { "const": "ARM-C-LIGHTWEIGHT-CLASSIFIER" } }, "required": ["arm_id"] }, "then": { "properties": { "input_profile_id": { "const": "urn:moirae:accord-02d:arm-input:lightweight-classifier:0.1" } } } },
        { "if": { "properties": { "arm_id": { "const": "ARM-D-ACCORD-EVIDENCE" } }, "required": ["arm_id"] }, "then": { "properties": { "input_profile_id": { "const": "urn:moirae:accord-02d:arm-input:accord-evidence:0.1" } } } },
        { "if": { "properties": { "arm_id": { "const": "ARM-C-LIGHTWEIGHT-CLASSIFIER" } }, "required": ["arm_id"] }, "then": { "required": ["classifier_feature_profile_ref"] } },
        { "if": { "properties": { "arm_id": { "enum": ["ARM-A-DURABLE", "ARM-B-PROVIDER-OBSERVATION", "ARM-D-ACCORD-EVIDENCE"] } }, "required": ["arm_id"] }, "then": { "not": { "required": ["classifier_feature_profile_ref"] } } }
      ]
    },
    "fieldRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "source_class", "value_type"],
      "properties": {
        "field_path": { "type": "string", "minLength": 1 },
        "source_class": { "enum": ["ORCHESTRATION", "TASK_IDENTITY", "ATTEMPT_STATE", "DELEGATE_CLAIM", "TRANSPORT_METADATA", "AUTHORITY_INPUT", "PROVIDER_OBSERVATION", "CLASSIFIER_FEATURE", "PORTABLE_RECORD", "EVIDENCE_ARTIFACT", "PROFILE_OR_TRUST_ROOT"] },
        "value_type": { "enum": ["STRING", "BOOLEAN", "INTEGER", "OBJECT", "ARRAY", "DIGEST", "TYPED_REFERENCE", "PROFILE_DEFINED"] }
      }
    },
    "forbiddenField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "reason"],
      "properties": {
        "field_path": { "type": "string", "minLength": 1 },
        "reason": { "enum": ["HIDDEN_ORACLE", "EXPECTED_RESULT", "SCORER_ONLY", "ACCORD_ONLY_OUTCOME", "PRIVILEGED_AUTHORITY_ANSWER", "PRIVATE_STATE", "POST_RUN_ADJUDICATION"] }
      }
    },
    "profileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "profile_id", "profile_version", "schema_id", "schema_version"],
      "properties": {
        "record_type": { "const": "PROFILE" },
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_version": { "type": "string", "minLength": 1 },
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
