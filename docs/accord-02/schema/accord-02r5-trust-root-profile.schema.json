{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5:schema:trust-root-profile:0.1",
  "title": "ACCORD-02R5 trust-root profile contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "record_type", "profile_id", "profile_version", "roots"],
  "properties": {
    "schema_id": { "const": "urn:moirae:accord-02r5:schema:trust-root-profile:0.1" },
    "schema_version": { "const": "0.1" },
    "record_type": { "const": "TRUST_ROOT_PROFILE" },
    "profile_id": { "const": "urn:moirae:accord-02a:trust-root:fixture-v1" },
    "profile_version": { "const": "0.1" },
    "roots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/root" }, "uniqueItems": true }
  },
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_root_id", "root_kind", "subject_scope", "verification_material_reference", "algorithm_profile", "validity_interval", "revocation_or_replacement_rule", "authenticated_claim_types", "operator_boundary_declaration"],
      "properties": {
        "trust_root_id": { "type": "string", "minLength": 1 },
        "root_kind": { "enum": ["public_key", "pinned_issuer", "provider_profile", "fixture_key", "transparency_log"] },
        "subject_scope": { "type": "string", "minLength": 1 },
        "verification_material_reference": { "type": "string", "minLength": 1 },
        "algorithm_profile": { "type": "string", "minLength": 1 },
        "validity_interval": { "type": "object", "additionalProperties": false, "required": ["not_before", "not_after"], "properties": { "not_before": { "type": "string", "format": "date-time" }, "not_after": { "type": "string", "format": "date-time" } } },
        "revocation_or_replacement_rule": { "type": "string", "minLength": 1 },
        "authenticated_claim_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "operator_boundary_declaration": { "type": "string", "minLength": 1 }
      }
    }
  }
}
