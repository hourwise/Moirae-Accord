{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r4:schema:canonicalization-profile:0.1",
  "title": "ACCORD-02R4 canonicalization profile",
  "description": "A versioned canonicalization contract for supplied digest verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "profile_id", "profile_version", "algorithm", "method", "encoding", "included_fields", "excluded_fields", "applies_to"],
  "properties": {
    "schema_id": { "const": "urn:moirae:accord-02r4:schema:canonicalization-profile:0.1" },
    "schema_version": { "const": "0.1" },
    "profile_id": { "const": "urn:moirae:accord-02r4:canonicalization:rfc8785-jcs:0.1" },
    "profile_version": { "const": "0.1" },
    "algorithm": { "const": "SHA-256" },
    "method": { "const": "RFC8785_JCS" },
    "encoding": { "const": "UTF-8" },
    "included_fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "excluded_fields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "applies_to": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/schemaApplicability" }, "uniqueItems": true }
  },
  "$defs": {
    "schemaApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "record_types"],
      "properties": {
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "record_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
