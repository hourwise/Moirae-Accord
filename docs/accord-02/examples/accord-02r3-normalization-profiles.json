        { "rule_id": "C-CONFIDENCE", "source_path": "payload.confidence_class", "claim_field": "indeterminacy_category", "mapping": { "HIGH": "NONE", "LOW": "INSUFFICIENT", "ABSTAIN": "TERMINAL" }, "on_missing": "NO_CLAIM" }
      ],
