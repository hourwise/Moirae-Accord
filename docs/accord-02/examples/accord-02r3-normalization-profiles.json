        { "rule_id": "B-STATE", "source_path": "payload.provider.state_read", "claim_field": "provider_stage_claim", "mapping": { "VISIBLE": "STATE_OBSERVED", "ABSENT": "NO_MATCHING_STATE", "INCOMPLETE": "INCOMPLETE_STATE" }, "on_missing": "NO_CLAIM" }
      ],
