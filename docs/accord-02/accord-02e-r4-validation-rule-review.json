  "rule_assessment_notes": [
    {"rule_ids":["BND-004","BND-005"],"assessment":"The resolution algorithms are deterministic in principle, but their required schema/profile inputs are not all resolvable from the current package and therefore cannot establish a complete valid acceptance bundle."},
    {"rule_ids":["SRC-001","SRC-002","SRC-003","SRC-004"],"assessment":"Source membership is named and deterministic, but ten source schema contracts used by the active registry are absent from the R4 package inventory."},
    {"rule_ids":["DIGEST-CANON-001","DIGEST-CANON-002","DIGEST-CANON-003"],"assessment":"The JCS/SHA-256 method is explicit, but the declared applicability is keyed to generic bundle-entry forms and does not match all concrete digest-bearing record forms."},
    {"rule_ids":["ROLE-001","VIS-001"],"assessment":"The primary role-visibility profile is closed, but the source-schema registry carries unconstrained role strings and is not normatively forced through the same vocabulary."}
