  "rules": [
    { "rule_id": "BND-001", "category": "BUNDLE", "inputs": ["declared bundle envelope"], "condition": { "operator": "bundle_type_and_inventory_closed", "scope": "supplied validation bundle" }, "failure_code": "ACCORD-02R3-BUNDLE-SCOPE-INVALID", "severity": "BLOCKING", "required_for": ["structural admission", "verifier admission", "experiment-run admission", "scoring admission"], "depends_on": [], "produces": ["BUNDLE_SCOPE_DECLARED"] },
    { "rule_id": "BND-002", "category": "BUNDLE", "inputs": ["bundle record inventory", "active profiles"], "condition": { "operator": "self_contained_scope", "forbidden": ["filesystem search", "database search", "network lookup", "hidden cache", "private Accord state"] }, "failure_code": "ACCORD-02R3-UNDECLARED-SCOPE", "severity": "BLOCKING", "required_for": ["verifier admission", "experiment-run admission", "scoring admission"], "depends_on": ["BND-001"], "produces": ["SCOPE_SELF_CONTAINED"] },
    { "rule_id": "BND-003", "category": "BUNDLE", "inputs": ["bundle information class", "visibility flags"], "condition": { "operator": "scorer_material_separated", "arm_and_verifier_bundles_forbid": ["SCORER_EXPECTATION", "ORACLE_RECORD", "SCORE_RECORD"] }, "failure_code": "ACCORD-02R3-SCORER-MATERIAL-IN-BUNDLE", "severity": "BLOCKING", "required_for": ["verifier admission", "experiment-run admission"], "depends_on": ["BND-001"], "produces": ["SCORER_MATERIAL_SEPARATED"] },
    { "rule_id": "BND-004", "category": "BUNDLE", "inputs": ["bundle records", "declared schema/profile contracts in validation scope"], "condition": { "operator": "resolve", "result_enum": ["RESOLVED", "MISSING", "DUPLICATE", "WRONG_TYPE", "STRUCTURALLY_INVALID"], "selection": "never_first_match", "schema_selection": "record schema_id and schema_version select the declared structural contract in the supplied scope" }, "failure_code": "ACCORD-02R3-RESOLUTION-UNDETERMINED", "severity": "BLOCKING", "required_for": ["verifier admission", "experiment-run admission", "scoring admission"], "depends_on": ["BND-001", "BND-002"], "produces": ["RESOLUTION_SEMANTICS_FIXED"] },
    { "rule_id": "BND-005", "category": "BUNDLE", "inputs": ["bundle inventory", "active profile references", "profile records or supplied profile definitions"], "condition": { "operator": "active_profiles_supplied_and_resolved", "required_profile_classes": ["validation rules", "extension registry", "predicate applicability", "source schema registry when experiment-scoped", "role visibility when experiment-scoped", "normalization when scoring", "classifier features when ARM-C"] }, "failure_code": "ACCORD-02R3-ACTIVE-PROFILE-MISSING", "severity": "BLOCKING", "required_for": ["verifier admission", "experiment-run admission"], "depends_on": ["BND-001", "BND-004"], "produces": ["ACTIVE_PROFILES_RESOLVED"] },
    { "rule_id": "RUN-001", "category": "RUN_CONTRACT", "inputs": ["experiment run record"], "condition": { "operator": "experiment_run_binds", "fields": ["experiment_run_id", "scenario_id", "arm_id", "arm_input_manifest_ref", "experiment_profile_ref", "source_schema_registry_ref", "role_visibility_profile_ref", "validation_rule_profile_ref", "normalization_profile_ref", "classifier_feature_profile_ref when ARM-C"] }, "failure_code": "ACCORD-02R3-EXPERIMENT-RUN-INCOMPLETE", "severity": "BLOCKING", "required_for": ["experiment-run admission", "scoring admission"], "depends_on": ["BND-005"], "produces": ["EXPERIMENT_RUN_BOUND"] },
    { "rule_id": "RUN-002", "category": "RUN_CONTRACT", "inputs": ["verifier run record"], "condition": { "operator": "verifier_run_binds", "fields": ["verifier_run_id", "input_bundle_ref", "verifier_profile_ref", "settlement_profile_ref", "extension_registry_ref", "predicate_applicability_profile_ref", "validation_rule_profile_ref", "produced_result_ref", "experiment_run_ref when experiment-scoped"], "private_state_used": false, "oracle_used": false }, "failure_code": "ACCORD-02R3-VERIFIER-RUN-INCOMPLETE", "severity": "BLOCKING", "required_for": ["verifier admission"], "depends_on": ["BND-005"], "produces": ["VERIFIER_RUN_BOUND"] },
    { "rule_id": "RUN-003", "category": "RUN_CONTRACT", "inputs": ["experiment run", "arm manifest"], "condition": { "operator": "run_and_manifest_agree", "fields": ["experiment_run_id", "scenario_id", "arm_id", "input_profile_id", "source_schema_registry_ref", "role_visibility_profile_ref", "validation_rule_profile_ref", "normalization_profile_ref", "classifier_feature_profile_ref when ARM-C"] }, "failure_code": "ACCORD-02R3-RUN-MANIFEST-MISMATCH", "severity": "BLOCKING", "required_for": ["experiment-run admission"], "depends_on": ["RUN-001", "ARM-001", "ARM-002"], "produces": ["RUN_MANIFEST_BOUND"] },
    { "rule_id": "RUN-004", "category": "RUN_CONTRACT", "inputs": ["experiment run", "verifier run"], "condition": { "operator": "no_scorer_reference", "forbidden_fields": ["scorer_expectation_ref", "oracle_ref", "score_record_ref"] }, "failure_code": "ACCORD-02R3-RUN-SCORER-REFERENCE", "severity": "BLOCKING", "required_for": ["experiment-run admission", "verifier admission"], "depends_on": ["RUN-001", "RUN-002", "BND-003"], "produces": ["RUN_SCORER_SEPARATION_VALID"] },
    { "rule_id": "EXT-001", "category": "EXTENSION", "inputs": ["extension registry", "portable record extensions"], "condition": { "operator": "every_relevant_extension_classified", "unknown_result": "UNKNOWN_FORBIDDEN" }, "failure_code": "ACCORD-02R3-EXTENSION-UNREGISTERED", "severity": "BLOCKING", "required_for": ["verifier admission", "experiment-run admission"], "depends_on": ["BND-005"], "produces": ["EXTENSIONS_CLASSIFIED"] },
    { "rule_id": "EXT-002", "category": "EXTENSION", "inputs": ["extension registry", "NON_SEMANTIC extensions"], "condition": { "operator": "non_semantic_not_used_for", "forbidden": ["authority", "occurrence", "attribution", "settlement", "normalization"] }, "failure_code": "ACCORD-02R3-NON-SEMANTIC-USED", "severity": "BLOCKING", "required_for": ["verifier admission", "scoring admission"], "depends_on": ["EXT-001"], "produces": ["NON_SEMANTIC_EXTENSIONS_ISOLATED"] },
    { "rule_id": "EXT-003", "category": "EXTENSION", "inputs": ["AUTHORITY_BEARING extension", "authority profile"], "condition": { "operator": "comparator_required" }, "failure_code": "ACCORD-02R3-AUTHORITY-EXTENSION-NO-COMPARATOR", "severity": "BLOCKING", "required_for": ["verifier admission"], "depends_on": ["EXT-001", "BND-005"], "produces": ["AUTHORITY_EXTENSIONS_PROFILED"] },
    { "rule_id": "EXT-004", "category": "EXTENSION", "inputs": ["SETTLEMENT_BEARING or EVIDENCE_BEARING extension", "settlement/evidence profile"], "condition": { "operator": "profile_semantics_required" }, "failure_code": "ACCORD-02R3-EVIDENCE-EXTENSION-NO-PROFILE", "severity": "BLOCKING", "required_for": ["verifier admission"], "depends_on": ["EXT-001", "BND-005"], "produces": ["EVIDENCE_EXTENSIONS_PROFILED"] },
    { "rule_id": "EXT-005", "category": "EXTENSION", "inputs": ["unknown or incompatible extension"], "condition": { "operator": "cannot_strengthen_result" }, "failure_code": "ACCORD-02R3-EXTENSION-CANNOT-STRENGTHEN", "severity": "BLOCKING", "required_for": ["verifier admission"], "depends_on": ["EXT-001"], "produces": ["UNKNOWN_EXTENSIONS_NON_STRENGTHENING"] },
    { "rule_id": "EXT-006", "category": "EXTENSION", "inputs": ["arm-visible portable bundle", "extension registry"], "condition": { "operator": "registry_in_scope_before_use" }, "failure_code": "ACCORD-02R3-EXTENSION-REGISTRY-MISSING", "severity": "BLOCKING", "required_for": ["experiment-run admission", "verifier admission"], "depends_on": ["BND-005", "EXT-001"], "produces": ["ARM_EXTENSIONS_REGISTRY_CHECKED"] },
    { "rule_id": "SRC-001", "category": "SOURCE_MEMBERSHIP", "inputs": ["arm source reference", "source-schema registry"], "condition": { "operator": "schema_membership", "fields": ["source_type", "record_type", "schema_id", "schema_version"] }, "failure_code": "ACCORD-02R3-SOURCE-SCHEMA-NOT-PERMITTED", "severity": "BLOCKING", "required_for": ["experiment-run admission"], "depends_on": ["BND-005", "ARM-001"], "produces": ["SOURCE_MEMBERSHIP_VALID"] },
    { "rule_id": "SRC-002", "category": "SOURCE_MEMBERSHIP", "inputs": ["source reference", "source-schema registry"], "condition": { "operator": "wrong_source_class_rejected" }, "failure_code": "ACCORD-02R3-SOURCE-CLASS-MISMATCH", "severity": "BLOCKING", "required_for": ["experiment-run admission"], "depends_on": ["SRC-001"], "produces": ["SOURCE_CLASS_VALID"] },
    { "rule_id": "SRC-003", "category": "SOURCE_MEMBERSHIP", "inputs": ["source reference", "source-schema registry"], "condition": { "operator": "registry_not_filename_driven" }, "failure_code": "ACCORD-02R3-SOURCE-FILENAME-NOT-AUTHORITY", "severity": "MAJOR", "required_for": ["experiment-run admission"], "depends_on": ["SRC-001"], "produces": ["SOURCE_REGISTRY_AUTHORITATIVE"] },
    { "rule_id": "SRC-004", "category": "SOURCE_MEMBERSHIP", "inputs": ["provider/transport/raw output", "portable evidence"], "condition": { "operator": "external_record_not_portable_evidence_by_shape" }, "failure_code": "ACCORD-02R3-SOURCE-EVIDENCE-MASQUERADE", "severity": "BLOCKING", "required_for": ["verifier admission", "experiment-run admission"], "depends_on": ["SRC-001", "EXT-001"], "produces": ["SOURCE_SEMANTICS_SEPARATED"] },
    { "rule_id": "VIS-001", "category": "ROLE_VISIBILITY", "inputs": ["role-visibility profile", "arm manifest fields"], "condition": { "operator": "field_consumer_is_allowed", "fixture_private_not_arm_visible": true }, "failure_code": "ACCORD-02R3-VISIBILITY-VIOLATION", "severity": "BLOCKING", "required_for": ["experiment-run admission"], "depends_on": ["BND-005", "RUN-001"], "produces": ["VISIBILITY_VALID"] },
    { "rule_id": "NORM-001", "category": "NORMALIZATION", "inputs": ["raw arm output", "normalization profile"], "condition": { "operator": "inputs_only", "allowed": ["raw arm output", "applicable normalization profile"] }, "failure_code": "ACCORD-02R3-NORMALIZATION-INPUT-INVALID", "severity": "BLOCKING", "required_for": ["scoring admission"], "depends_on": ["RAW-001", "BND-005"], "produces": ["NORMALIZATION_INPUTS_VALID"] },
    { "rule_id": "NORM-002", "category": "NORMALIZATION", "inputs": ["normalization process inputs"], "condition": { "operator": "oracle_and_scorer_truth_absent" }, "failure_code": "ACCORD-02R3-NORMALIZATION-ORACLE-INPUT", "severity": "BLOCKING", "required_for": ["scoring admission"], "depends_on": ["NORM-001", "BND-003"], "produces": ["NORMALIZATION_TRUTH_FREE"] },
    { "rule_id": "NORM-003", "category": "NORMALIZATION", "inputs": ["raw arm output", "normalization profile"], "condition": { "operator": "same_inputs_same_claim" }, "failure_code": "ACCORD-02R3-NORMALIZATION-NONDETERMINISTIC", "severity": "MAJOR", "required_for": ["scoring admission"], "depends_on": ["NORM-001"], "produces": ["NORMALIZATION_DETERMINISTIC"] },
    { "rule_id": "NORM-004", "category": "NORMALIZATION", "inputs": ["malformed or unmapped raw output", "normalization profile"], "condition": { "operator": "profile_defined_failure" }, "failure_code": "ACCORD-02R3-NORMALIZATION-MALFORMED-UNDEFINED", "severity": "MAJOR", "required_for": ["scoring admission"], "depends_on": ["NORM-001"], "produces": ["NORMALIZATION_MALFORMED_DEFINED"] },
    { "rule_id": "NORM-005", "category": "NORMALIZATION", "inputs": ["normalized claim", "scorer truth"], "condition": { "operator": "comparison_after_normalization" }, "failure_code": "ACCORD-02R3-NORMALIZATION-TRUTH-REINTERPRETATION", "severity": "BLOCKING", "required_for": ["scoring admission"], "depends_on": ["NORM-002", "NORM-003"], "produces": ["NORMALIZATION_BEFORE_SCORING"] },
    { "rule_id": "CLF-001", "category": "CLASSIFIER_FEATURE", "inputs": ["classifier feature", "classifier feature profile"], "condition": { "operator": "feature_registered" }, "failure_code": "ACCORD-02R3-CLASSIFIER-FEATURE-UNREGISTERED", "severity": "BLOCKING", "required_for": ["experiment-run admission", "scoring admission"], "depends_on": ["BND-005", "SRC-001"], "produces": ["CLASSIFIER_FEATURES_REGISTERED"] },
    { "rule_id": "CLF-002", "category": "CLASSIFIER_FEATURE", "inputs": ["derived classifier feature", "ARM-C source set"], "condition": { "operator": "derivation_subset_of_allowed_sources" }, "failure_code": "ACCORD-02R3-CLASSIFIER-UPSTREAM-INVALID", "severity": "BLOCKING", "required_for": ["experiment-run admission"], "depends_on": ["CLF-001", "SRC-001"], "produces": ["CLASSIFIER_UPSTREAM_VALID"] },
    { "rule_id": "CLF-003", "category": "CLASSIFIER_FEATURE", "inputs": ["classifier feature derivation"], "condition": { "operator": "forbidden_upstream_absent", "forbidden": ["SCORER_EXPECTATION", "ORACLE_RECORD", "SETTLEMENT_RESULT", "VERIFIER_RESULT", "AUTHORITY_ANALYSIS_RESULT", "CATEGORICAL_FAILURE_EVALUATION"] }, "failure_code": "ACCORD-02R3-CLASSIFIER-PRIVILEGED-UPSTREAM", "severity": "BLOCKING", "required_for": ["experiment-run admission", "scoring admission"], "depends_on": ["CLF-001", "CLF-002"], "produces": ["CLASSIFIER_NO_PRIVILEGED_INPUT"] },
    { "rule_id": "CLF-004", "category": "CLASSIFIER_FEATURE", "inputs": ["classifier feature"], "condition": { "operator": "unknown_feature_rejected" }, "failure_code": "ACCORD-02R3-CLASSIFIER-FEATURE-UNKNOWN", "severity": "BLOCKING", "required_for": ["experiment-run admission"], "depends_on": ["CLF-001"], "produces": ["CLASSIFIER_FEATURE_SET_CLOSED"] },
    { "rule_id": "PRED-001", "category": "PREDICATE_APPLICABILITY", "inputs": ["canonical proposition", "predicate applicability profile"], "condition": { "operator": "required_binding_not_unknown_or_na_for_positive_projection" }, "failure_code": "ACCORD-02R3-REQUIRED-BINDING-UNRESOLVED", "severity": "BLOCKING", "required_for": ["verifier admission"], "depends_on": ["BND-005", "PROP-001"], "produces": ["REQUIRED_BINDINGS_RESOLVED"] },
    { "rule_id": "PRED-002", "category": "PREDICATE_APPLICABILITY", "inputs": ["binding slot", "predicate applicability profile"], "condition": { "operator": "not_applicable_profile_declared" }, "failure_code": "ACCORD-02R3-NOT-APPLICABLE-UNJUSTIFIED", "severity": "BLOCKING", "required_for": ["verifier admission"], "depends_on": ["PRED-001"], "produces": ["NA_BINDINGS_JUSTIFIED"] },
    { "rule_id": "PRED-003", "category": "PREDICATE_APPLICABILITY", "inputs": ["binding slot"], "condition": { "operator": "unknown_not_positive_binding" }, "failure_code": "ACCORD-02R3-UNKNOWN-BINDING-STRENGTHENING", "severity": "BLOCKING", "required_for": ["verifier admission"], "depends_on": ["PRED-001"], "produces": ["UNKNOWN_BINDINGS_NON_STRENGTHENING"] },
