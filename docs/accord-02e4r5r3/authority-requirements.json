{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_ref": {
    "kind": "SCHEMA",
    "id": "urn:moirae:accord-02r5r3:schema:authority-requirements",
    "version": "0.2"
  },
  "$id": "urn:moirae:accord-02r5r3:authority-requirements:0.2",
  "object_id": "urn:moirae:accord-02r5r3:authority-requirements",
  "object_version": "0.2",
  "package_requirements": {
    "family": "urn:moirae:accord-02r5:specification-package",
    "version": "0.2",
    "status": "CANDIDATE_UNACCEPTED",
    "accepted_base_version": "0.1",
    "required_rejected_revision": {
      "revision": "E4R5R2",
      "commit": "44d0e7240c97dcc12463b5611a7adf61399924d7"
    }
  },
  "stage_policy_requirements": {
    "global_stage_order": "FORBIDDEN",
    "implicit_transitivity": "FORBIDDEN"
  },
  "stage_policy_authorization": {
    "global_stage_order": [
      "FORBIDDEN"
    ],
    "implicit_transitivity": [
      "FORBIDDEN"
    ]
  },
  "canonicalization_requirements": {
    "standard": "RFC8785",
    "serialization": "RFC8785_JCS",
    "encoding": "UTF-8",
    "algorithm": "SHA-256",
    "target_id": "PACKAGE_EXCLUDING_SELF_DIGEST",
    "selection": "ENTIRE_PACKAGE_DOCUMENT",
    "reduction": "REMOVE_POINTER",
    "exclusion_pointers": [
      "/current_candidate_integrity/digest"
    ]
  },
  "partial_effect_requirements": {
    "same_effect_required": true,
    "direct_predecessor_required": true,
    "merged_decision_key": "UNKNOWN_TUPLE_OR_WRONG_STAGE",
    "merged_decision_value": "REJECT"
  },
  "classification_requirements": {
    "conformance": "invariant_binding exists and validates",
    "internal": "internal_check exists and no invariant_binding",
    "deferred": "missing_subject_roles and later_lifecycle_stage exist and no binding/check"
  },
  "governing_contract_refs": {
    "integrity_modes": {
      "kind": "CONTRACT",
      "id": "urn:moirae:accord-02r5r3:integrity-modes",
      "version": "0.2"
    },
    "semantic_key_authority": {
      "kind": "CONTRACT",
      "id": "urn:moirae:accord-02r5r3:semantic-key-authority",
      "version": "0.2"
    },
    "governance_requirements": {
      "kind": "CONTRACT",
      "id": "urn:moirae:accord-02r5r3:governance-requirements",
      "version": "0.2"
    },
    "external_verification_contract": {
      "kind": "CONTRACT",
      "id": "urn:moirae:accord-02r5r3:external-verification-input-contract",
      "version": "0.2"
    }
  },
  "trust_boundary_requirements": {
    "layers": [
      "INTERNAL_PACKAGE_CONFORMANCE",
      "TRUSTED_PACKAGE_IDENTITY"
    ],
    "external_input_source": "CALLER_SUPPLIED_OUTSIDE_OBJECT_REGISTRY",
    "candidate_self_assertion_permitted": false,
    "missing_external_input_result": "FAIL",
    "cli": [
      "--expected-package-id",
      "--expected-package-version",
      "--expected-package-digest",
      "--verification-input"
    ],
    "trust_root_kinds": [
      "PINNED_ACCEPTED_TRUST_ROOT",
      "REPLACED_TRUST_ROOT"
    ],
    "result_vocabulary": [
      "PASS",
      "FAIL",
      "DIFFERENT_PACKAGE_VERIFIED"
    ],
    "replacement_sub_status": "OUT_OF_SCOPE_TRUST_ROOT_REPLACEMENT"
  }
}
