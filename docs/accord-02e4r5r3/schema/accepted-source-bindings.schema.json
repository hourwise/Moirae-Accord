{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5r3:schema:accepted-source-bindings:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "sources"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02r5r3:[a-z0-9-]+:0.2$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "const": "0.2"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "path",
          "status",
          "roles",
          "integrity"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/ref"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "ACTIVE_ACCEPTED_SOURCE"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "integrity": {
            "type": "object",
            "required": [
              "semantic_json_content_sha256",
              "raw_file_bytes_sha256",
              "raw_byte_preservation"
            ],
            "additionalProperties": false,
            "properties": {
              "semantic_json_content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "raw_file_bytes_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "raw_byte_preservation": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
