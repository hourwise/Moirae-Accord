{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5r3:schema:proposition-inventory:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "derived_from",
    "collection_propositions",
    "member_propositions",
    "projection_propositions",
    "informational"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02r5r3:[a-z0-9-]+:0.2$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "const": "0.2"
    },
    "derived_from": {
      "type": "object"
    },
    "collection_propositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "proposition_id",
          "kind",
          "normative",
          "member_pointer",
          "derived_from"
        ],
        "properties": {
          "proposition_id": {
            "type": "string"
          },
          "kind": {
            "const": "COLLECTION"
          },
          "normative": {
            "type": "boolean"
          },
          "member_pointer": {
            "type": "string"
          },
          "derived_from": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "member_propositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "proposition_id",
          "kind",
          "normative",
          "member_of",
          "derived_from"
        ],
        "properties": {
          "proposition_id": {
            "type": "string"
          },
          "kind": {
            "const": "MEMBER"
          },
          "normative": {
            "type": "boolean"
          },
          "member_of": {
            "type": "string"
          },
          "derived_from": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "projection_propositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "proposition_id",
          "kind",
          "normative",
          "collection_proposition_id",
          "projection"
        ],
        "properties": {
          "proposition_id": {
            "type": "string"
          },
          "kind": {
            "const": "PROJECTION"
          },
          "normative": {
            "type": "boolean"
          },
          "collection_proposition_id": {
            "type": "string"
          },
          "projection": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "informational": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
