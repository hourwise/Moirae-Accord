{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5r3:schema:invariant-registry:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "invariants"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02r5r3:[a-z0-9-]+:0.2$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "const": "0.2"
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "invariant_id",
          "status",
          "class",
          "usage",
          "acceptance_critical",
          "procedure_id",
          "input_roles",
          "subject_roles",
          "default_arguments",
          "compatible_failure_codes",
          "fail_closed"
        ],
        "properties": {
          "invariant_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "RETIRED"
            ]
          },
          "class": {
            "enum": [
              "PACKAGE_CONFORMANCE",
              "GOVERNANCE",
              "TRUST"
            ]
          },
          "usage": {
            "type": "string"
          },
          "acceptance_critical": {
            "type": "boolean"
          },
          "procedure_id": {
            "type": "string"
          },
          "input_roles": {
            "type": "array",
            "minItems": 1
          },
          "subject_roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "default_arguments": {
            "type": "object",
            "minProperties": 1
          },
          "compatible_failure_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fail_closed": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
