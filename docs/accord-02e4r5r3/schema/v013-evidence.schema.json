{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5r3:schema:v013-evidence:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "fixture_status",
    "source_accepted_evidence_id",
    "evidence_id",
    "effect_id",
    "predicate_id",
    "stage",
    "scope",
    "observed_interval",
    "retention_window_seconds",
    "consistency_level",
    "read_semantics",
    "read_scope_complete",
    "observed_at",
    "verification_time",
    "evidence_class",
    "evidence_universe"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02r5r3:[a-z0-9-]+:0.2$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "const": "0.2"
    },
    "fixture_status": {
      "const": "SYNTHETIC_CANDIDATE_0_2_NOT_ACCEPTED_HISTORY"
    },
    "source_accepted_evidence_id": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    },
    "effect_id": {
      "type": "string"
    },
    "predicate_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "resource",
        "action",
        "recipient_or_counterparty",
        "provider"
      ],
      "properties": {
        "resource": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "recipient_or_counterparty": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "observed_interval": {
      "type": "object",
      "required": [
        "not_before",
        "as_of"
      ],
      "properties": {
        "not_before": {
          "type": "string"
        },
        "as_of": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "retention_window_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "consistency_level": {
      "type": "string"
    },
    "read_semantics": {
      "type": "string"
    },
    "read_scope_complete": {
      "type": "boolean"
    },
    "observed_at": {
      "type": "string"
    },
    "verification_time": {
      "type": "string"
    },
    "evidence_class": {
      "type": "string"
    },
    "evidence_universe": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidenceItem": {
      "type": "object",
      "required": [
        "evidence_id",
        "effect_id",
        "predicate_id",
        "stage",
        "scope",
        "polarity",
        "relationship",
        "admissible",
        "observed_interval",
        "consistency_level",
        "source_class"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "required": [
            "resource",
            "action",
            "recipient_or_counterparty",
            "provider"
          ],
          "properties": {
            "resource": {
              "type": "string"
            },
            "action": {
              "type": "string"
            },
            "recipient_or_counterparty": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "polarity": {
          "enum": [
            "POSITIVE",
            "NEGATIVE"
          ]
        },
        "relationship": {
          "enum": [
            "SAME_TARGET",
            "DIFFERENT_TARGET",
            "IRRELEVANT"
          ]
        },
        "admissible": {
          "type": "boolean"
        },
        "observed_interval": {
          "type": "object",
          "required": [
            "not_before",
            "as_of"
          ],
          "properties": {
            "not_before": {
              "type": "string"
            },
            "as_of": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "consistency_level": {
          "type": "string",
          "minLength": 1
        },
        "source_class": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
