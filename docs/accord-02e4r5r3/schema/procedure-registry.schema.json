{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5r3:schema:procedure-registry:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "procedures"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02r5r3:[a-z0-9-]+:0.2$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "const": "0.2"
    },
    "procedures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "procedure_id",
          "arguments",
          "derivation",
          "result",
          "missing_behavior",
          "ambiguity_behavior",
          "fail_closed"
        ],
        "properties": {
          "procedure_id": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "minItems": 1
          },
          "derivation": {
            "type": "object",
            "minProperties": 1
          },
          "result": {
            "type": "object"
          },
          "missing_behavior": {
            "type": "string"
          },
          "ambiguity_behavior": {
            "type": "string"
          },
          "fail_closed": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
