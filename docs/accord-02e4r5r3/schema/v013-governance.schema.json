{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5r3:schema:v013-governance:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "fixture_status",
    "accepted_v013_locator",
    "relationship_vocabulary",
    "relationship_basis_schema",
    "authority_roots",
    "result_vocabulary",
    "requirement_map",
    "policy_field_roles",
    "pass_result",
    "fail_result"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02r5r3:[a-z0-9-]+:0.2$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "const": "0.2"
    },
    "fixture_status": {
      "const": "NORMATIVE_CANDIDATE_0_2"
    },
    "accepted_v013_locator": {
      "type": "object",
      "required": [
        "source_ref",
        "accepted_member_id"
      ],
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/ref"
        },
        "accepted_member_id": {
          "type": "string"
        }
      }
    },
    "relationship_vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "relationship_basis_schema": {
      "type": "object"
    },
    "authority_roots": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "result_vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "requirement_map": {
      "type": "object",
      "required": [
        "required_requirement_ids",
        "requirements",
        "evaluation_order",
        "forbidden_requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "required_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "requirement_id",
              "source_fields",
              "governing_authority",
              "procedure",
              "failure_code"
            ],
            "properties": {
              "requirement_id": {
                "type": "string",
                "minLength": 1
              },
              "source_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "governing_authority": {
                "type": "string",
                "minLength": 1
              },
              "procedure": {
                "type": "string",
                "minLength": 1
              },
              "failure_code": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "evaluation_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "forbidden_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "policy_field_roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "pass_result": {
      "type": "string"
    },
    "fail_result": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
