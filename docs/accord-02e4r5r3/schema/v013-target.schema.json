{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5r3:schema:v013-target:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "candidate_proposition_id",
    "effect_id",
    "negated_predicate_id",
    "negated_stage",
    "scope",
    "required_interval",
    "settlement_profile_ref",
    "source_vector_ref",
    "relationship",
    "relationship_basis"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02r5r3:[a-z0-9-]+:0.2$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "const": "0.2"
    },
    "candidate_proposition_id": {
      "type": "string"
    },
    "effect_id": {
      "type": "string"
    },
    "negated_predicate_id": {
      "type": "string"
    },
    "negated_stage": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "resource",
        "action",
        "recipient_or_counterparty",
        "provider"
      ],
      "properties": {
        "resource": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "recipient_or_counterparty": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "required_interval": {
      "type": "object",
      "required": [
        "not_before",
        "as_of"
      ],
      "properties": {
        "not_before": {
          "type": "string"
        },
        "as_of": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "settlement_profile_ref": {
      "$ref": "#/$defs/ref"
    },
    "source_vector_ref": {
      "$ref": "#/$defs/ref"
    },
    "relationship": {
      "type": "string",
      "minLength": 1
    },
    "relationship_basis": {
      "type": "object",
      "required": [
        "accepted",
        "candidate_supplied"
      ],
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "field_id",
              "accepted_pointer"
            ],
            "properties": {
              "field_id": {
                "type": "string"
              },
              "accepted_pointer": {
                "type": "string"
              },
              "must_equal": {},
              "must_contain": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "candidate_supplied": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "field_id",
              "candidate_pointer",
              "provenance"
            ],
            "properties": {
              "field_id": {
                "type": "string"
              },
              "candidate_pointer": {
                "type": "string"
              },
              "provenance": {
                "const": "CANDIDATE_LOCAL_NOT_HISTORY"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
