{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02e4r5r4:schema:rule-registry:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "provenance",
    "rules"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02e4r5r4:[a-z0-9-]+:0.2$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "const": "0.2"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_revision",
        "source_commit",
        "source_tree",
        "source_rule_registry_semantic_sha256",
        "required_rule_ids",
        "required_rule_inventory_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "source_revision": {
          "type": "string"
        },
        "source_commit": {
          "type": "string"
        },
        "source_tree": {
          "type": "string"
        },
        "source_rule_registry_semantic_sha256": {
          "type": "string"
        },
        "required_rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "required_rule_inventory_hash": {
          "type": "string"
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "declared_class",
          "inherited_family",
          "inherited_failure_code",
          "provenance_source_revision",
          "provenance_source_commit"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "declared_class": {
            "enum": [
              "EXECUTABLE_CONFORMANCE_RULE",
              "INTERNAL_DESIGN_INVARIANT",
              "DEFERRED_NO_SUBJECT_ARTIFACT"
            ]
          },
          "inherited_family": {
            "type": "string"
          },
          "inherited_failure_code": {
            "type": "string"
          },
          "provenance_source_revision": {
            "type": "string"
          },
          "provenance_source_commit": {
            "type": "string"
          },
          "invariant_binding": {
            "type": "object"
          },
          "internal_check": {
            "type": "object"
          },
          "missing_subject_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "later_lifecycle_stage": {
            "type": "string"
          },
          "deferred_reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
