{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02e4r5r4:schema:v013-target:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "candidate_proposition_id",
    "effect_id",
    "negated_predicate_id",
    "negated_stage",
    "scope",
    "required_interval",
    "settlement_profile_ref",
    "source_vector_ref",
    "relationship",
    "relationship_basis"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02e4r5r4:[a-z0-9-]+:0.2$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "const": "0.2"
    },
    "candidate_proposition_id": {
      "type": "string"
    },
    "effect_id": {
      "type": "string"
    },
    "negated_predicate_id": {
      "type": "string"
    },
    "negated_stage": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "resource",
        "action",
        "recipient_or_counterparty",
        "provider"
      ],
      "properties": {
        "resource": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "recipient_or_counterparty": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "required_interval": {
      "type": "object",
      "required": [
        "not_before",
        "as_of"
      ],
      "properties": {
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "settlement_profile_ref": {
      "$ref": "#/$defs/ref"
    },
    "source_vector_ref": {
      "$ref": "#/$defs/ref"
    },
    "relationship": {
      "type": "string",
      "minLength": 1
    },
    "relationship_basis": {
      "type": "object",
      "required": [
        "accepted",
        "candidate_supplied"
      ],
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "field_id",
              "selector"
            ],
            "properties": {
              "field_id": {
                "type": "string",
                "minLength": 1
              },
              "selector": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "pointer_tokens",
                      "must_equal"
                    ],
                    "properties": {
                      "kind": {
                        "const": "VALUE"
                      },
                      "pointer_tokens": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "must_equal": {}
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "pointer_tokens",
                      "must_contain"
                    ],
                    "properties": {
                      "kind": {
                        "const": "ARRAY_CONTAINS"
                      },
                      "pointer_tokens": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "must_contain": {}
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "candidate_supplied": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "field_id",
              "pointer_tokens",
              "provenance"
            ],
            "properties": {
              "field_id": {
                "type": "string",
                "minLength": 1
              },
              "pointer_tokens": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "provenance": {
                "const": "CANDIDATE_LOCAL_NOT_HISTORY"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
