{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02e4r5r4:schema:specification-package:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "package_id",
    "package_version",
    "status",
    "accepted_base_ref",
    "rejected_candidate_lineage",
    "object_registry_ref",
    "rule_registry_ref",
    "invariant_registry_ref",
    "procedure_registry_ref",
    "required_invariant_ids",
    "required_rule_ids_ref",
    "trust_anchor_requirement_ref",
    "registry_semantic_sha256",
    "runtime",
    "current_candidate_integrity",
    "metacontract_ref",
    "primitive_registry_ref"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "const": "urn:moirae:accord-02r5:specification-package:0.2"
    },
    "object_id": {
      "const": "urn:moirae:accord-02r5:specification-package"
    },
    "object_version": {
      "const": "0.2"
    },
    "package_id": {
      "type": "string"
    },
    "package_version": {
      "const": "0.2"
    },
    "status": {
      "const": "CANDIDATE_UNACCEPTED"
    },
    "accepted_base_ref": {
      "$ref": "#/$defs/ref"
    },
    "rejected_candidate_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "revision",
          "status"
        ],
        "properties": {
          "revision": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "object_registry_ref": {
      "$ref": "#/$defs/ref"
    },
    "rule_registry_ref": {
      "$ref": "#/$defs/ref"
    },
    "invariant_registry_ref": {
      "$ref": "#/$defs/ref"
    },
    "procedure_registry_ref": {
      "$ref": "#/$defs/ref"
    },
    "required_invariant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_rule_ids_ref": {
      "type": "string"
    },
    "trust_anchor_requirement_ref": {
      "$ref": "#/$defs/ref"
    },
    "registry_semantic_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime": {
      "type": "object",
      "required": [
        "python",
        "requirements_path"
      ],
      "additionalProperties": false,
      "properties": {
        "python": {
          "type": "string"
        },
        "requirements_path": {
          "type": "string"
        }
      }
    },
    "current_candidate_integrity": {
      "type": "object",
      "required": [
        "class",
        "content_target_ref",
        "algorithm",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string"
        },
        "content_target_ref": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "metacontract_ref": {
      "$ref": "#/$defs/ref"
    },
    "primitive_registry_ref": {
      "$ref": "#/$defs/ref"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
