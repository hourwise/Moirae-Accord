{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02e4r5r4:schema:procedure-registry",
  "title": "ACCORD-02E4R5R4 executable procedure registry schema",
  "type": "object",
  "required": [
    "$schema",
    "schema_ref",
    "$id",
    "object_id",
    "object_version",
    "procedures"
  ],
  "properties": {
