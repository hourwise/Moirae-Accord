      "const": "urn:moirae:accord-02e4r5r4:procedure-registry:0.2"
    },
    "object_id": {
      "const": "urn:moirae:accord-02e4r5r4:procedure-registry"
    },
    "object_version": {
      "const": "0.2"
    },
    "procedures": {
      "type": "array",
      "minItems": 39,
      "maxItems": 39,
      "items": {
        "$ref": "#/$defs/procedure"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "typed_ref": {
      "type": "object",
      "required": [
