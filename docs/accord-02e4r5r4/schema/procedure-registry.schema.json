            "ACTIVE_ACCEPTED_SOURCE"
          ]
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "schema_required": {
          "const": true
        },
        "integrity_required": {
          "const": true
        },
        "identity_constraint": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "BINDING_REFERENCE"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "mode",
                "ref",
                "canonical_path",
                "raw_sha256",
                "semantic_sha256",
                "git_blob"
              ],
              "properties": {
                "mode": {
                  "const": "EXACT_REFERENCE"
                },
                "ref": {
                  "$ref": "#/$defs/typed_ref"
                },
                "canonical_path": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "semantic_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "git_blob": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "argument": {
      "type": "object",
      "required": [
        "name",
        "type",
        "required",
        "cardinality",
        "origin"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "enum": [
            "REGISTRY",
            "CONTRACT",
            "PACKAGE",
            "AUTHORITY",
            "CANONICALIZATION",
            "NORMATIVE_INPUTS",
            "SOURCE_VECTOR_CATALOG",
            "POLICY",
            "EVIDENCE",
            "SEMANTIC_KEYS",
            "VERIFICATION_UNIVERSE",
            "FROZEN_RULE_AUTHORITY",
            "FROZEN_V013_GOVERNANCE",
            "EXTERNAL_TRUST",
            "EXTERNAL_ACCEPTANCE_PROFILE"
          ]
        },
        "required": {
          "const": true
        },
        "cardinality": {
          "const": "ONE"
        },
        "origin": {
          "enum": [
            "RULE_BINDING",
            "BOOTSTRAP_VERIFICATION_UNIVERSE",
            "EXTERNAL_FROZEN_AUTHORITY",
            "EXTERNAL_FROZEN_PREDECESSOR",
            "EXTERNAL_TRUST",
            "EXTERNAL_ACCEPTANCE_PROFILE"
          ]
        },
        "source_constraint": {
          "$ref": "#/$defs/source_constraint"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "RULE_BINDING"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "source_constraint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "enum": [
                  "BOOTSTRAP_VERIFICATION_UNIVERSE",
                  "EXTERNAL_FROZEN_AUTHORITY",
                  "EXTERNAL_FROZEN_PREDECESSOR",
                  "EXTERNAL_TRUST",
                  "EXTERNAL_ACCEPTANCE_PROFILE"
                ]
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "not": {
              "required": [
                "source_constraint"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "arg"
          ],
          "properties": {
            "arg": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {}
          },
          "additionalProperties": false
        },
        {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "op",
                "universe",
                "reference"
              ],
              "properties": {
                "op": {
                  "const": "RESOLVE_ONE"
                },
                "universe": {
                  "$ref": "#/$defs/expression"
                },
                "reference": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "value",
                "pointer"
              ],
              "properties": {
                "op": {
                  "const": "GET"
                },
                "value": {
                  "$ref": "#/$defs/expression"
                },
                "pointer": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "object",
                "key"
              ],
              "properties": {
                "op": {
                  "const": "GET_KEY"
                },
                "object": {
                  "$ref": "#/$defs/expression"
                },
                "key": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "left",
                "right"
              ],
              "properties": {
                "op": {
                  "const": "JSON_EQUAL"
                },
                "left": {
                  "$ref": "#/$defs/expression"
                },
                "right": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "left",
                "right"
              ],
              "properties": {
                "op": {
                  "const": "SET_EQUAL_STRICT"
                },
                "left": {
                  "$ref": "#/$defs/expression"
                },
                "right": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "array",
                "pointers"
              ],
              "properties": {
                "op": {
                  "const": "UNIQUE_BY"
                },
                "array": {
                  "$ref": "#/$defs/expression"
                },
                "pointers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "array",
                "as",
                "where"
              ],
              "properties": {
                "op": {
                  "const": "FILTER"
                },
                "array": {
                  "$ref": "#/$defs/expression"
                },
                "as": {
                  "type": "string",
                  "minLength": 1
                },
                "where": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "array",
                "as",
                "fields"
              ],
              "properties": {
                "op": {
                  "const": "PROJECT"
                },
                "array": {
                  "$ref": "#/$defs/expression"
                },
                "as": {
                  "type": "string",
                  "minLength": 1
                },
                "fields": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "$ref": "#/$defs/expression"
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "array"
              ],
              "properties": {
                "op": {
                  "const": "COUNT"
                },
                "array": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "array",
                "as",
                "where"
              ],
              "properties": {
                "op": {
                  "const": "ALL"
                },
                "array": {
                  "$ref": "#/$defs/expression"
                },
                "as": {
                  "type": "string",
                  "minLength": 1
                },
                "where": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "array",
                "as",
                "where"
              ],
              "properties": {
                "op": {
                  "const": "ANY"
                },
                "array": {
                  "$ref": "#/$defs/expression"
                },
                "as": {
                  "type": "string",
                  "minLength": 1
                },
                "where": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "value"
              ],
              "properties": {
                "op": {
                  "const": "NOT"
                },
                "value": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "left",
                "comparator",
                "right"
              ],
              "properties": {
                "op": {
                  "const": "NUMERIC_COMPARE"
                },
                "left": {
                  "$ref": "#/$defs/expression"
                },
                "comparator": {
                  "enum": [
                    "LT",
                    "LTE",
                    "EQ",
                    "NE",
                    "GTE",
                    "GT"
                  ]
                },
                "right": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "left",
                "comparator",
                "right"
              ],
              "properties": {
                "op": {
                  "const": "RFC3339_COMPARE"
                },
                "left": {
                  "$ref": "#/$defs/expression"
                },
                "comparator": {
                  "enum": [
                    "LT",
                    "LTE",
                    "EQ",
                    "NE",
                    "GTE",
                    "GT"
                  ]
                },
                "right": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "start",
                "end"
              ],
              "properties": {
                "op": {
                  "const": "DURATION_SECONDS"
                },
                "start": {
                  "$ref": "#/$defs/expression"
                },
                "end": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "schema",
                "instance",
                "mode"
              ],
              "properties": {
                "op": {
                  "const": "SCHEMA_VALIDATE"
                },
                "schema": {
                  "$ref": "#/$defs/expression"
                },
                "instance": {
                  "$ref": "#/$defs/expression"
                },
                "mode": {
                  "enum": [
                    "META_SCHEMA",
                    "INSTANCE"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "value",
                "expected",
                "algorithm",
                "serialization",
                "excluded_pointers"
              ],
              "properties": {
                "op": {
                  "const": "DIGEST_VERIFY"
                },
                "value": {
                  "$ref": "#/$defs/expression"
                },
                "expected": {
                  "$ref": "#/$defs/expression"
                },
                "algorithm": {
                  "$ref": "#/$defs/expression"
                },
                "serialization": {
                  "$ref": "#/$defs/expression"
                },
                "excluded_pointers": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "value"
              ],
              "properties": {
                "op": {
                  "const": "DESCENDANTS"
                },
                "value": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "op",
                "universe",
                "registry",
                "reference_model",
                "reference_form"
              ],
              "properties": {
                "op": {
                  "const": "ENUMERATE_TYPED_REFERENCES"
                },
                "universe": {
                  "$ref": "#/$defs/expression"
                },
                "registry": {
                  "$ref": "#/$defs/expression"
                },
                "reference_model": {
                  "$ref": "#/$defs/expression"
                },
                "reference_form": {
                  "$ref": "#/$defs/expression"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "assertion": {
      "type": "object",
      "required": [
        "assertion_id",
        "condition",
        "failure_code",
        "witness"
      ],
      "properties": {
        "assertion_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "condition": {
          "$ref": "#/$defs/expression"
        },
        "failure_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "witness": {
          "$ref": "#/$defs/expression"
        }
      },
      "additionalProperties": false
    },
    "procedure": {
      "type": "object",
      "required": [
        "procedure_id",
        "arguments",
        "assertions",
        "compatible_failure_codes",
        "result",
        "missing_behavior",
        "ambiguity_behavior",
        "fail_closed"
      ],
      "properties": {
        "procedure_id": {
          "enum": [
            "SCHEMA_VALIDATION",
            "LINEAGE_VALIDATION",
            "DUAL_INTEGRITY",
            "UNIQUE_KEY",
            "REFERENCE_RESOLUTION",
            "DIGEST_RECOMPUTE",
            "SET_EQUALITY",
            "EXPECTATION_STABILITY",
            "PREDICATE_POLICY_AGREEMENT",
            "CANONICALIZATION_PROFILE_WELLFORMED",
            "SOURCE_CATALOG_BINDING_MATCH",
            "PARTIAL_EFFECT_POLICY_CLOSURE",
            "REQUIREMENT_MAP_EVAL",
            "AUTHORITY_COMPLETENESS",
            "PROPOSITION_INVENTORY_BOUND",
            "PROFILE_REFERENCE_PINNING",
            "ARITY_AGREEMENT",
            "SCHEMA_NON_VACUITY",
            "CURRENT_PACKAGE_IDENTITY",
            "SELF_DIGEST",
            "INTEGRITY_MODE_DISPATCH",
            "V013_BASIS_VALID",
            "FAIL_CLOSED_ENFORCED",
            "SUBJECT_ROLE_COVERAGE",
            "DEFAULT_ARGUMENT_COVERAGE",
            "DERIVATION_ROLE_CLOSURE",
            "PROCEDURE_OPERATION_SUPPORTED",
            "MISSING_BEHAVIOR_SUPPORTED",
            "AMBIGUITY_BEHAVIOR_SUPPORTED",
            "REFERENCE_DISCOVERY_SCOPE_VALID",
            "REFERENCE_SHAPE_PREDICATE_APPLIED",
            "UNIQUENESS_KEY_APPLIED",
            "ROLE_MODEL_APPLIED",
            "SCHEMA_IDENTITY_MATCHES_REGISTRY",
            "RULE_COVERAGE_EXACT",
            "INVARIANT_SET_EXACT",
            "GOVERNING_AUTHORITY_REFERENCE_VALID",
            "GOVERNING_TOKEN_SINGLETON",
            "TRUST_ANCHOR_COMPARE"
          ]
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "compatible_failure_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          }
        },
        "result": {
          "type": "object",
          "required": [
            "type",
            "status",
            "witness_required"
          ],
          "properties": {
            "type": {
              "enum": [
                "BOOLEAN",
                "TRUST_RESULT"
              ]
            },
            "status": {
              "const": [
                "PASS",
                "FAIL"
              ]
            },
            "witness_required": {
              "const": true
            },
            "success_code": {
              "const": "EXPECTED_PACKAGE_VERIFIED"
            },
            "result_projection": {
              "type": "object",
              "required": [
                "argument",
                "pointer_tokens",
                "mapping_cardinality",
                "expected_literals",
                "baseline"
              ],
              "properties": {
                "argument": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer_tokens": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "mapping_cardinality": {
                  "type": "integer",
                  "minimum": 0
                },
                "expected_literals": {
                  "type": "object",
                  "required": [
                    "PASS",
                    "FAIL"
                  ],
                  "properties": {
                    "PASS": {
                      "type": "string",
                      "minLength": 1
                    },
                    "FAIL": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "baseline": {
                  "type": "object",
                  "required": [
                    "argument",
                    "source_pin",
                    "status_pointer_tokens"
                  ],
                  "properties": {
                    "argument": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_pin": {
                      "type": "object",
                      "required": [
                        "commit",
                        "tree",
                        "path",
                        "git_blob"
                      ],
                      "properties": {
                        "commit": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{40}$"
                        },
                        "tree": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{40}$"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "git_blob": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{40}$"
                        }
                      },
                      "additionalProperties": false
                    },
                    "status_pointer_tokens": {
                      "type": "object",
                      "required": [
                        "PASS",
                        "FAIL"
                      ],
                      "properties": {
                        "PASS": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string"
                          }
                        },
                        "FAIL": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "TRUST_RESULT"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {
                "required": [
                  "success_code"
                ],
                "not": {
                  "required": [
                    "result_projection"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "BOOLEAN"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "success_code"
                  ]
                }
              }
            }
          ],
          "additionalProperties": false
        },
        "missing_behavior": {
          "type": "string",
          "minLength": 1
        },
        "ambiguity_behavior": {
          "type": "string",
          "minLength": 1
        },
        "fail_closed": {
          "const": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "procedure_id": {
                "const": "REQUIREMENT_MAP_EVAL"
              }
            },
            "required": [
              "procedure_id"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "required": [
                  "result_projection"
