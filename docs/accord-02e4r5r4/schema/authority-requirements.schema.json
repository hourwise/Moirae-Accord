{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02e4r5r4:schema:authority-requirements:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "package_requirements",
    "stage_policy_requirements",
    "stage_policy_authorization",
    "canonicalization_requirements",
    "partial_effect_requirements",
    "classification_requirements",
    "governing_contract_refs",
    "trust_boundary_requirements"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02e4r5r4:[a-z0-9-]+:0.2$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "const": "0.2"
    },
    "package_requirements": {
      "type": "object"
    },
    "stage_policy_requirements": {
      "type": "object",
      "required": [
        "global_stage_order",
        "implicit_transitivity"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "stage_policy_authorization": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "canonicalization_requirements": {
      "type": "object"
    },
    "partial_effect_requirements": {
      "type": "object",
      "required": [
        "merged_decision_key"
      ],
      "properties": {
        "merged_decision_key": {
          "type": "string"
        }
      }
    },
    "classification_requirements": {
      "type": "object"
    },
    "governing_contract_refs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ref"
      }
    },
    "trust_boundary_requirements": {
      "type": "object",
      "required": [
        "layers",
        "external_input_source",
        "candidate_self_assertion_permitted",
        "required_external_fields",
        "expected_identity",
        "missing_external_input_result",
        "trust_result_schema_ref",
        "cli",
        "result_vocabulary",
        "replacement_sub_status",
        "acceptance_profile_input_source",
        "candidate_authority_claim_comparison",
        "source_content_verification",
        "preflight_failure_codes",
        "profile_fallback",
        "acceptance_profile_schema_input"
      ],
      "properties": {
        "layers": {
          "const": [
            "INTERNAL_PACKAGE_CONFORMANCE",
            "TRUSTED_PACKAGE_IDENTITY"
          ]
        },
        "external_input_source": {
          "const": "CALLER_SUPPLIED_OUTSIDE_OBJECT_REGISTRY"
        },
        "candidate_self_assertion_permitted": {
          "const": false
        },
        "required_external_fields": {
          "const": [
            "expected_package_id",
            "expected_package_version",
            "expected_package_digest",
            "external_acceptance_profile",
            "acceptance_profile_schema_identity",
            "acceptance_profile_schema_bytes",
            "acceptance_profile_schema_sha256"
          ]
        },
        "expected_identity": {
          "type": "object",
          "required": [
            "package_id",
            "package_version",
            "digest_algorithm",
            "digest_serialization",
            "excluded_pointers"
          ],
          "properties": {
            "package_id": {
              "const": "urn:moirae:accord-02r5:specification-package"
            },
            "package_version": {
              "const": "0.2"
            },
            "digest_algorithm": {
              "const": "SHA-256"
            },
            "digest_serialization": {
              "const": "RFC8785_JCS"
            },
            "excluded_pointers": {
              "const": [
                "/current_candidate_integrity/digest"
              ]
            }
          },
          "additionalProperties": false
        },
        "missing_external_input_result": {
          "const": "FAIL"
        },
        "trust_result_schema_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "const": {
                "kind": "SCHEMA",
                "id": "urn:moirae:accord-02e4r5r4:schema:metacontract",
                "version": "0.2",
                "member_id": "trust_result"
              }
            }
          ]
        },
        "cli": {
          "const": [
            "--expected-package-id",
            "--expected-package-version",
            "--expected-package-digest",
            "--verification-input",
            "--acceptance-profile-schema-id",
            "--acceptance-profile-schema",
            "--acceptance-profile-schema-sha256"
          ]
        },
        "result_vocabulary": {
          "const": [
            "PASS",
            "FAIL"
          ]
        },
        "replacement_sub_status": {
          "const": "OUT_OF_SCOPE"
        },
        "acceptance_profile_input_source": {
          "const": "CALLER_SUPPLIED_SEPARATELY_VIA_VERIFICATION_INPUT"
        },
        "candidate_authority_claim_comparison": {
          "const": "WHOLE_OBJECT_EQUALITY_BEFORE_SEMANTIC_USE"
        },
        "source_content_verification": {
          "const": {
            "acceptance_profile_schema": {
              "required": true,
              "schema_identity": "urn:moirae:accord-02e4r5r4:external-acceptance-profile-schema:1",
              "schema_identity_argument": "--acceptance-profile-schema-id",
              "expected_schema_identity_origin": "CALLER_SUPPLIED_OUTSIDE_CANDIDATE",
              "schema_bytes_argument": "--acceptance-profile-schema",
              "expected_sha256_argument": "--acceptance-profile-schema-sha256",
              "expected_sha256_algorithm": "SHA-256",
              "expected_sha256_origin": "CALLER_SUPPLIED_OUTSIDE_CANDIDATE",
              "digest_input": "RAW_SCHEMA_BYTES",
              "verify_digest_before_parse_or_use": true,
              "verify_schema_identity_and_dialect_after_digest": true,
              "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
              "candidate_registry_selection": "FORBIDDEN",
              "candidate_schema_override": "FORBIDDEN",
              "candidate_embedded_schema_fallback": "FORBIDDEN",
              "candidate_registry_fallback": "FORBIDDEN",
              "unregistered_transport_copy": "docs/accord-02e4r5r4/sources/external-acceptance-profile.schema.json",
              "transport_copy_authority": "NONE_CALLER_MUST_SUPPLY_BYTES_AND_EXPECTED_DIGEST_SEPARATELY"
            },
            "schema_document": "STRICT_UTF8_JSON_REJECT_DUPLICATE_MEMBERS_VALID_DRAFT_2020_12_SCHEMA",
            "schema_bytes": "CALLER_INPUT_BYTES_ONLY",
            "profile_bytes": "CALLER_SUPPLIED_EXTERNAL_ACCEPTANCE_PROFILE_ONLY",
            "base64_decode": "STRICT_RFC4648_NO_WHITESPACE",
            "json_decode": "UTF8_REJECT_DUPLICATE_MEMBER_NAMES",
            "frozen_sources": {
              "git_blob": "SHA1(ASCII('blob '+DECIMAL_BYTE_LENGTH)+NUL+RAW_BYTES)",
              "content_use": "PARSED_CONTENT_ONLY_AFTER_PIN_MATCH"
            },
            "accepted_sources": {
              "raw_sha256": "SHA256_RAW_BYTES",
              "semantic_sha256": "SHA256_RFC8785_JCS_PARSED_JSON",
              "git_blob": "SHA1_GIT_BLOB_OBJECT",
              "metadata": "EXACT_REF_PATH_ROLE_STATUS_CLASS_AND_SCHEMA"
            },
            "candidate_source_copies": "TRANSPORT_ONLY_NEVER_AUTHORITY_OR_RESOLVER_INPUT",
            "candidate_registry_fallback": "FORBIDDEN"
          }
        },
        "preflight_failure_codes": {
          "const": [
            "MISSING_EXTERNAL_PROFILE_SCHEMA",
            "EXTERNAL_PROFILE_SCHEMA_DIGEST_MISMATCH",
            "INVALID_EXTERNAL_PROFILE_SCHEMA",
            "MISSING_EXTERNAL_ACCEPTANCE_PROFILE",
            "INVALID_EXTERNAL_ACCEPTANCE_PROFILE",
            "EXTERNAL_FROZEN_R5R2_CONTENT_MISMATCH",
            "EXTERNAL_FROZEN_R5R3_CONTENT_MISMATCH",
            "EXTERNAL_ACCEPTED_BASE_CONTENT_MISMATCH",
            "EXTERNAL_ACCEPTED_VECTOR_CONTENT_MISMATCH",
            "METACONTRACT_R5R2_PIN_CLAIM_MISMATCH",
            "METACONTRACT_R5R3_PIN_CLAIM_MISMATCH",
            "METACONTRACT_ACCEPTED_ALLOWLIST_CLAIM_MISMATCH",
            "METACONTRACT_PROJECTION_CLAIM_MISMATCH",
            "PROCEDURE_PROJECTION_CLAIM_MISMATCH"
          ]
        },
        "profile_fallback": {
          "const": "FORBIDDEN"
        },
        "acceptance_profile_schema_input": {
          "const": {
            "required": true,
            "schema_identity": "urn:moirae:accord-02e4r5r4:external-acceptance-profile-schema:1",
            "schema_identity_argument": "--acceptance-profile-schema-id",
            "expected_schema_identity_origin": "CALLER_SUPPLIED_OUTSIDE_CANDIDATE",
            "schema_bytes_argument": "--acceptance-profile-schema",
            "expected_sha256_argument": "--acceptance-profile-schema-sha256",
            "expected_sha256_algorithm": "SHA-256",
            "expected_sha256_origin": "CALLER_SUPPLIED_OUTSIDE_CANDIDATE",
            "digest_input": "RAW_SCHEMA_BYTES",
            "verify_digest_before_parse_or_use": true,
            "verify_schema_identity_and_dialect_after_digest": true,
            "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
            "candidate_registry_selection": "FORBIDDEN",
            "candidate_schema_override": "FORBIDDEN",
            "candidate_embedded_schema_fallback": "FORBIDDEN",
            "candidate_registry_fallback": "FORBIDDEN",
            "unregistered_transport_copy": "docs/accord-02e4r5r4/sources/external-acceptance-profile.schema.json",
            "transport_copy_authority": "NONE_CALLER_MUST_SUPPLY_BYTES_AND_EXPECTED_DIGEST_SEPARATELY"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
