{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02e4r5r4:schema:integrity-modes:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "modes",
    "dispatch"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02e4r5r4:[a-z0-9-]+:0.2$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "const": "0.2"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mode",
          "input",
          "canonicalization",
          "algorithm",
          "expected_digest_source",
          "verification_operation",
          "failure_code",
          "applicability"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "canonicalization": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "type": "string",
            "minLength": 1
          },
          "expected_digest_source": {
            "type": "string",
            "minLength": 1
          },
          "verification_operation": {
            "type": "string",
            "minLength": 1
          },
          "failure_code": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "dispatch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "mode",
          "object_ref",
          "role",
          "algorithm",
          "serialization",
          "excluded_pointers"
        ],
        "properties": {
          "mode": {
            "type": "string"
          },
          "object_ref": {
            "$ref": "#/$defs/ref"
          },
          "role": {
            "type": "string"
          },
          "algorithm": {
            "enum": [
              "SHA-256",
              "SHA-1"
            ]
          },
          "serialization": {
            "enum": [
              "RFC8785_JCS",
              "RAW_BYTES",
              "GIT_BLOB_OBJECT"
            ]
          },
          "excluded_pointers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "supported_algorithms": {
      "const": [
        "SHA-256",
        "SHA-1"
      ]
    },
    "supported_serializations": {
      "const": [
        "RFC8785_JCS",
        "RAW_BYTES",
        "GIT_BLOB_OBJECT"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
