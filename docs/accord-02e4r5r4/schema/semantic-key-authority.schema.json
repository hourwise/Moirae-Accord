{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02e4r5r4:schema:semantic-key-authority:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "semantic_keys",
    "governing_token_singleton"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02e4r5r4:[a-z0-9-]+:0.2$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "const": "0.2"
    },
    "semantic_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "authority_path",
          "governed_mirror_paths",
          "permitted_provenance_roles",
          "allowed_occurrences"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "authority_path": {
            "type": "string",
            "minLength": 1
          },
          "governed_mirror_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permitted_provenance_roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "allowed_occurrences": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "pointer_tokens"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "AUTHORITY",
                    "CANONICALIZATION",
                    "CONTRACT",
                    "EVIDENCE",
                    "NORMATIVE_INPUTS",
                    "POLICY",
                    "REGISTRY"
                  ]
                },
                "pointer_tokens": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "governing_token_singleton": {
      "type": "object",
      "required": [
        "scan_excludes_kinds",
        "permitted_exception_roles",
        "scan_excluded_pointer_prefixes"
      ],
      "properties": {
        "scan_excludes_kinds": {
          "type": "array"
        },
        "permitted_exception_roles": {
          "type": "array"
        },
        "scan_excluded_pointer_prefixes": {
          "type": "array"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCHEMA",
            "REGISTRY",
            "CONTRACT",
            "AUTHORITY",
            "NORMATIVE_INPUTS",
            "CANONICALIZATION",
            "POLICY",
            "EVIDENCE",
            "PACKAGE",
            "SOURCE_VECTOR_CATALOG"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
