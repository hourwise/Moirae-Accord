{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02e4r4:schema:specification-package:0.2",
  "title": "ACCORD-02E4R4 specification-package semantic domain",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "package_id",
    "package_version",
    "status",
    "lineage",
    "active_instances",
    "active_profiles_manifest_path",
    "operator_registry_path",
    "assertion_registry_path",
    "rules_path",
    "graph_path",
    "source_catalog_binding_path",
    "canonicalization_authority_path",
    "predicate_registry_path",
    "design_freeze"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02e4r4:"
    },
    "package_id": {
      "type": "string"
    },
    "package_version": {
      "const": "0.2"
    },
    "status": {
      "const": "CANDIDATE_UNACCEPTED"
    },
    "lineage": {
      "type": "object"
    },
    "active_instances": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "path",
          "schema_id",
          "schema_path",
          "status"
        ],
        "properties": {
          "artifact": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "x-normative-reference": {
              "reference_kind": "ACTIVE_INSTANCE"
            }
          },
          "schema_id": {
            "type": "string"
          },
          "schema_path": {
            "type": "string",
            "minLength": 1,
            "x-normative-reference": {
              "reference_kind": "SCHEMA"
            }
          },
          "status": {
            "const": "ACTIVE"
          }
        },
        "additionalProperties": false
      }
    },
    "active_profiles_manifest_path": {
      "type": "string",
      "minLength": 1,
      "x-normative-reference": {
        "reference_kind": "PROFILE_MANIFEST"
      }
    },
    "operator_registry_path": {
      "type": "string",
      "minLength": 1,
      "x-normative-reference": {
        "reference_kind": "OPERATOR_REGISTRY"
      }
    },
    "assertion_registry_path": {
      "type": "string",
      "minLength": 1,
      "x-normative-reference": {
        "reference_kind": "ASSERTION_REGISTRY"
      }
    },
    "rules_path": {
      "type": "string",
      "minLength": 1,
      "x-normative-reference": {
        "reference_kind": "RULES"
      }
    },
    "graph_path": {
      "type": "string",
      "minLength": 1,
      "x-normative-reference": {
        "reference_kind": "GRAPH"
      }
    },
    "source_catalog_binding_path": {
      "type": "string",
      "minLength": 1,
      "x-normative-reference": {
        "reference_kind": "EXTERNAL_MEMBER_BINDING"
      }
    },
    "canonicalization_authority_path": {
      "type": "string",
      "minLength": 1,
      "x-normative-reference": {
        "reference_kind": "CANONICALIZATION_PROFILE"
      }
    },
    "predicate_registry_path": {
      "type": "string",
      "minLength": 1,
      "x-normative-reference": {
        "reference_kind": "PREDICATE_REGISTRY"
      }
    },
    "design_freeze": {
      "type": "object",
      "required": [
        "vectors",
        "expectation_axes",
        "must_not_conclude",
        "accepted_outcome_changes"
      ],
      "properties": {
        "vectors": {
          "const": 23
        },
        "expectation_axes": {
          "const": 13
        },
        "must_not_conclude": {
          "const": 31
        },
        "accepted_outcome_changes": {
          "const": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "status"
          ]
        },
        {
          "required": [
            "package_version"
          ]
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "CANDIDATE_UNACCEPTED"
            }
          }
        },
        {
          "required": [
            "accepted_at"
          ]
        }
      ]
    }
  ]
}
