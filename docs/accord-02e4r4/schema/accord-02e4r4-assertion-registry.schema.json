{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02e4r4:schema:assertion-registry:0.2",
  "title": "ACCORD-02E4R4 assertion-registry semantic domain",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "registry_id",
    "registry_version",
    "assertions"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:moirae:accord-02e4r4:"
    },
    "registry_id": {
      "type": "string"
    },
    "registry_version": {
      "const": "0.2"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assertion_id",
          "expression",
          "result_type",
          "error_behavior"
        ]
      }
    }
  },
  "additionalProperties": true
}
