{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5:schema:negative-requirement-map:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "object_id",
    "object_version",
    "governing_profile_ref",
    "requirements",
    "evaluation_order",
    "caller_supplied_contradiction_count"
  ],
  "properties": {
    "$schema": {
      "const": "urn:moirae:accord-02r5:schema:negative-requirement-map:0.2"
    },
    "$id": {
      "const": "urn:moirae:accord-02r5:negative-requirement-map:0.2"
    },
    "object_id": {
      "const": "urn:moirae:accord-02r5:negative-requirement-map"
    },
    "object_version": {
      "const": "0.2"
    },
    "governing_profile_ref": {
      "$ref": "#/$defs/objectRef"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "source_fields",
          "governing_authority",
          "procedure",
          "failure_code"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "source_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "governing_authority": {
            "const": "SETTLEMENT_PROFILE"
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          },
          "failure_code": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "evaluation_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "caller_supplied_contradiction_count": {
      "const": "FORBIDDEN"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "objectRef": {
      "type": "object",
      "x-normative-reference": true,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CONTRACT",
            "SCHEMA",
            "PROFILE",
            "SOURCE_VECTOR",
            "CANONICALIZATION",
            "POLICY",
            "REQUIREMENT_MAP",
            "PACKAGE",
            "REGISTRY"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
