{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5:schema:object-registry:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "object_id",
    "object_version",
    "uniqueness_key",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "urn:moirae:accord-02r5:schema:object-registry:0.2"
    },
    "$id": {
      "const": "urn:moirae:accord-02r5:object-registry:0.2"
    },
    "object_id": {
      "const": "urn:moirae:accord-02r5:object-registry"
    },
    "object_version": {
      "const": "0.2"
    },
    "uniqueness_key": {
      "const": [
        "kind",
        "id",
        "version"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id",
          "version",
          "path",
          "integrity",
          "status",
          "role"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "integrity": {
            "type": "object",
            "required": [
              "class",
              "method",
              "algorithm",
              "digest"
            ],
            "properties": {
              "class": {
                "enum": [
                  "SEMANTIC_JSON_CONTENT",
                  "SELF_EXCLUDING_SEMANTIC_JSON_CONTENT"
                ]
              },
              "method": {
                "const": "RFC8785_JCS"
              },
              "algorithm": {
                "const": "SHA-256"
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "exclusion_pointers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^/"
                }
              }
            },
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "objectRef": {
      "type": "object",
      "x-normative-reference": true,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CONTRACT",
            "SCHEMA",
            "PROFILE",
            "SOURCE_VECTOR",
            "CANONICALIZATION",
            "POLICY",
            "REQUIREMENT_MAP",
            "PACKAGE",
            "REGISTRY"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
