{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5:schema:assertion-registry:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "object_id",
    "object_version",
    "retired_primitive_ids",
    "assertions"
  ],
  "properties": {
    "$schema": {
      "const": "urn:moirae:accord-02r5:schema:assertion-registry:0.2"
    },
    "$id": {
      "const": "urn:moirae:accord-02r5:assertion-registry:0.2"
    },
    "object_id": {
      "const": "urn:moirae:accord-02r5:assertion-registry"
    },
    "object_version": {
      "const": "0.2"
    },
    "retired_primitive_ids": {
      "type": "array",
      "contains": {
        "const": "ASSERTION_EXPRESSION"
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assertion_id",
          "expression"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "type": "object",
            "required": [
              "operator",
              "checks"
            ],
            "properties": {
              "operator": {
                "enum": [
                  "ALL",
                  "ANY"
                ]
              },
              "checks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "primitive_ref",
                    "arguments"
                  ],
                  "properties": {
                    "primitive_ref": {
                      "$ref": "#/$defs/objectRef"
                    },
                    "arguments": {
                      "type": "object"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "objectRef": {
      "type": "object",
      "x-normative-reference": true,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CONTRACT",
            "SCHEMA",
            "PROFILE",
            "SOURCE_VECTOR",
            "CANONICALIZATION",
            "POLICY",
            "REQUIREMENT_MAP",
            "PACKAGE",
            "REGISTRY"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
