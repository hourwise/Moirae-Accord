{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5:schema:vector-catalog:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "object_id",
    "object_version",
    "catalog_id",
    "catalog_version",
    "source_catalog_ref",
    "vectors",
    "integrity"
  ],
  "properties": {
    "$schema": {
      "const": "urn:moirae:accord-02r5:schema:vector-catalog:0.2"
    },
    "$id": {
      "const": "urn:moirae:accord-02r5:vector-catalog:0.2"
    },
    "object_id": {
      "const": "urn:moirae:accord-02r5:vector-catalog"
    },
    "object_version": {
      "const": "0.2"
    },
    "catalog_id": {
      "const": "urn:moirae:accord-02r5:vector-catalog"
    },
    "catalog_version": {
      "const": "0.2"
    },
    "source_catalog_ref": {
      "$ref": "#/$defs/objectRef"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "vector_id",
          "source_vector_ref",
          "settlement_profile_ref",
          "evidence_profile_ref",
          "target",
          "expected",
          "classification"
        ],
        "properties": {
          "vector_id": {
            "type": "string",
            "minLength": 1
          },
          "source_vector_ref": {
            "$ref": "#/$defs/objectRef"
          },
          "settlement_profile_ref": {
            "$ref": "#/$defs/objectRef"
          },
          "evidence_profile_ref": {
            "$ref": "#/$defs/objectRef"
          },
          "target": {
            "type": "object",
            "required": [
              "proposition",
              "target_resolution",
              "canonicalization_ref"
            ],
            "properties": {
              "proposition": {
                "type": "object"
              },
              "target_resolution": {
                "type": "object"
              },
              "canonicalization_ref": {
                "$ref": "#/$defs/objectRef"
              }
            },
            "additionalProperties": true
          },
          "expected": {
            "type": "object"
          },
          "classification": {
            "const": "DECLARATIVE_EXPECTATION_VECTOR"
          }
        },
        "additionalProperties": true
      }
    },
    "integrity": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "objectRef": {
      "type": "object",
      "x-normative-reference": true,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CONTRACT",
            "SCHEMA",
            "PROFILE",
            "SOURCE_VECTOR",
            "CANONICALIZATION",
            "POLICY",
            "REQUIREMENT_MAP",
            "PACKAGE",
            "REGISTRY"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
