{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5:schema:canonicalization-profile:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "object_id",
    "object_version",
    "profile_id",
    "profile_version",
    "algorithm",
    "method",
    "encoding",
    "pointer_semantics",
    "missing_pointer_policy",
    "duplicate_pointer_policy",
    "content_targets"
  ],
  "properties": {
    "$schema": {
      "const": "urn:moirae:accord-02r5:schema:canonicalization-profile:0.2"
    },
    "$id": {
      "const": "urn:moirae:accord-02r5:canonicalization:rfc8785-jcs:0.2"
    },
    "object_id": {
      "const": "urn:moirae:accord-02r5:canonicalization:rfc8785-jcs"
    },
    "object_version": {
      "const": "0.2"
    },
    "profile_id": {
      "const": "urn:moirae:accord-02r5:canonicalization:rfc8785-jcs"
    },
    "profile_version": {
      "const": "0.2"
    },
    "algorithm": {
      "const": "SHA-256"
    },
    "method": {
      "const": "RFC8785_JCS"
    },
    "encoding": {
      "const": "UTF-8"
    },
    "pointer_semantics": {
      "const": "RFC6901"
    },
    "missing_pointer_policy": {
      "const": "FAIL"
    },
    "duplicate_pointer_policy": {
      "const": "FAIL"
    },
    "content_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "mode",
          "json_pointers"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "INCLUDE_JSON_POINTERS",
              "EXCLUDE_JSON_POINTERS"
            ]
          },
          "json_pointers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^/"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "objectRef": {
      "type": "object",
      "x-normative-reference": true,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CONTRACT",
            "SCHEMA",
            "PROFILE",
            "SOURCE_VECTOR",
            "CANONICALIZATION",
            "POLICY",
            "REQUIREMENT_MAP",
            "PACKAGE",
            "REGISTRY"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
