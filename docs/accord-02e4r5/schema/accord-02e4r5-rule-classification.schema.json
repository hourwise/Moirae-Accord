{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5:schema:rule-classification:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "object_id",
    "object_version",
    "total_declared_rules",
    "executable_in_package_0_2",
    "deferred_no_subject_artifact",
    "classifications"
  ],
  "properties": {
    "$schema": {
      "const": "urn:moirae:accord-02r5:schema:rule-classification:0.2"
    },
    "$id": {
      "const": "urn:moirae:accord-02r5:rule-classification:0.2"
    },
    "object_id": {
      "const": "urn:moirae:accord-02r5:rule-classification"
    },
    "object_version": {
      "const": "0.2"
    },
    "total_declared_rules": {
      "type": "integer",
      "minimum": 1
    },
    "executable_in_package_0_2": {
      "type": "integer",
      "minimum": 1
    },
    "deferred_no_subject_artifact": {
      "type": "integer",
      "minimum": 0
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "objectRef": {
      "type": "object",
      "x-normative-reference": true,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CONTRACT",
            "SCHEMA",
            "PROFILE",
            "SOURCE_VECTOR",
            "CANONICALIZATION",
            "POLICY",
            "REQUIREMENT_MAP",
            "PACKAGE",
            "REGISTRY"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
