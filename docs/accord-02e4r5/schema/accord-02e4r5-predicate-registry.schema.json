{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5:schema:predicate-registry:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "object_id",
    "object_version",
    "registry_id",
    "registry_version",
    "resolution_key",
    "comparison",
    "global_stage_order",
    "implicit_transitivity",
    "entries",
    "fail_closed_policy"
  ],
  "properties": {
    "$schema": {
      "const": "urn:moirae:accord-02r5:schema:predicate-registry:0.2"
    },
    "$id": {
      "const": "urn:moirae:accord-02r5:predicate-registry:0.2"
    },
    "object_id": {
      "const": "urn:moirae:accord-02r5:predicate-registry"
    },
    "object_version": {
      "const": "0.2"
    },
    "registry_id": {
      "const": "urn:moirae:accord-02r5:predicate-registry"
    },
    "registry_version": {
      "const": "0.2"
    },
    "resolution_key": {
      "const": [
        "predicate_id",
        "stage"
      ]
    },
    "comparison": {
      "const": "UNICODE_CODE_POINT_EXACT_CASE_SENSITIVE_NO_NORMALIZATION"
    },
    "global_stage_order": {
      "const": "FORBIDDEN"
    },
    "implicit_transitivity": {
      "const": "FORBIDDEN"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "predicate_id",
          "stage",
          "kind",
          "support_status",
          "required_bindings",
          "optional_bindings",
          "not_applicable_bindings",
          "predecessor_edges",
          "stage_settlement",
          "later_stage_policy",
          "proposition_schema_ref"
        ],
        "properties": {
          "predicate_id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "POSITIVE_STAGE",
              "GENERIC_OCCURRENCE",
              "NEGATIVE_SCOPE"
            ]
          },
          "support_status": {
            "type": "string",
            "minLength": 1
          },
          "required_bindings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "optional_bindings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "not_applicable_bindings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "predecessor_edges": {
            "type": "array"
          },
          "stage_settlement": {},
          "later_stage_policy": {},
          "proposition_schema_ref": {
            "$ref": "#/$defs/objectRef"
          },
          "negative_requirement_map_ref": {
            "$ref": "#/$defs/objectRef"
          }
        },
        "additionalProperties": false
      }
    },
    "fail_closed_policy": {
      "type": "object",
      "minProperties": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "objectRef": {
      "type": "object",
      "x-normative-reference": true,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CONTRACT",
            "SCHEMA",
            "PROFILE",
            "SOURCE_VECTOR",
            "CANONICALIZATION",
            "POLICY",
            "REQUIREMENT_MAP",
            "PACKAGE",
            "REGISTRY"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
