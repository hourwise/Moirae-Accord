{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02e4:schema:specification-package:0.2",
  "title": "ACCORD-02E4 candidate exact specification package",
  "description": "A closed candidate composition over the immutable 0.1 package plus explicitly enumerated settlement contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "package_version", "package_schema_id", "package_schema_version", "contract_policy", "base_package", "effective_inventory", "schema_contract_additions", "profile_contract_replacements", "profile_contract_additions", "canonicalization_profiles", "canonicalization_applicability", "role_vocabulary", "validation_rule_contract", "active_profile_reference_policy"],
  "properties": {
    "package_id": { "const": "urn:moirae:accord-02r5:specification-package" },
    "package_version": { "const": "0.2" },
    "package_schema_id": { "const": "urn:moirae:accord-02e4:schema:specification-package:0.2" },
    "package_schema_version": { "const": "0.2" },
    "contract_policy": { "const": "CLOSED_EXACT_VERSION" },
    "base_package": { "$ref": "#/$defs/basePackage" },
    "effective_inventory": { "$ref": "#/$defs/inventory" },
    "schema_contract_additions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/schemaContract" } },
    "profile_contract_replacements": { "type": "array", "items": { "$ref": "#/$defs/profileContract" } },
    "profile_contract_additions": { "type": "array", "items": { "$ref": "#/$defs/profileContract" } },
    "canonicalization_profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/canonicalizationRef" } },
    "canonicalization_applicability": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/canonicalizationMapping" } },
    "role_vocabulary": { "type": "array", "minItems": 1, "items": { "enum": ["ORCHESTRATOR", "DELEGATE_FIXTURE", "PROVIDER_FIXTURE", "OBSERVER_FIXTURE", "ARM-A-DURABLE", "ARM-B-PROVIDER-OBSERVATION", "ARM-C-LIGHTWEIGHT-CLASSIFIER", "ARM-D-ACCORD-EVIDENCE", "SCORER"] }, "uniqueItems": true },
    "validation_rule_contract": { "$ref": "#/$defs/ruleContract" },
    "active_profile_reference_policy": { "$ref": "#/$defs/referencePolicy" },
    "candidate_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_only", "base_is_immutable", "repository_fallback", "specification_scope", "negative_stage_marker"],
      "properties": {
        "candidate_only": { "const": true },
        "base_is_immutable": { "const": true },
        "repository_fallback": { "const": false },
        "specification_scope": { "type": "string", "minLength": 1 },
        "negative_stage_marker": { "type": "string", "minLength": 1 }
      }
    },
    "package_digest": { "type": "string", "pattern": "^sha-256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "basePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "package_version", "package_path", "package_sha256", "inheritance_policy", "schema_contract_count", "profile_contract_count", "canonicalization_profile_count", "role_count", "active_source_schema_pair_count", "active_arm_profile_reference_count", "active_rule_count"],
      "properties": {
        "package_id": { "const": "urn:moirae:accord-02r5:specification-package" },
        "package_version": { "const": "0.1" },
        "package_path": { "const": "docs/accord-02/accord-02r5-specification-package.json" },
        "package_sha256": { "const": "sha-256:fbb9c3cc97355905e7e12632706e6a982ea1187748f4d2259641f41d20be105c" },
        "inheritance_policy": { "const": "EXACT_UNCHANGED_CONTRACTS" },
        "schema_contract_count": { "const": 44 },
        "profile_contract_count": { "const": 31 },
        "canonicalization_profile_count": { "const": 1 },
        "role_count": { "const": 9 },
        "active_source_schema_pair_count": { "const": 13 },
        "active_arm_profile_reference_count": { "const": 16 },
        "active_rule_count": { "const": 82 }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_contracts", "profile_contracts", "canonicalization_profiles", "roles", "active_source_schema_pairs", "active_arm_profile_references", "active_validation_rules"],
      "properties": {
        "schema_contracts": { "const": 49 },
        "profile_contracts": { "const": 32 },
        "canonicalization_profiles": { "const": 1 },
        "roles": { "const": 9 },
        "active_source_schema_pairs": { "const": 13 },
        "active_arm_profile_references": { "const": 16 },
        "active_validation_rules": { "const": 82 }
      }
    },
    "schemaContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "normative_record_types", "schema_path", "contract_kind", "allowed_bundle_types", "digest_policy"],
      "properties": {
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "normative_record_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "schema_path": { "type": "string", "pattern": "^[^/]+(?:/[^/]+)*\\.json$" },
        "contract_kind": { "enum": ["INSTANCE_RECORD_SCHEMA", "BUNDLE_SCHEMA", "RUN_RECORD_SCHEMA", "SPECIFICATION_CONTRACT_SCHEMA"] },
        "allowed_bundle_types": { "type": "array", "minItems": 1, "items": { "enum": ["VERIFIER_VALIDATION_BUNDLE", "EXPERIMENT_VALIDATION_BUNDLE", "SCORER_BUNDLE", "SPECIFICATION_PACKAGE"] }, "uniqueItems": true },
        "canonicalization_profile_id": { "type": ["string", "null"] },
        "digest_policy": { "enum": ["OPTIONAL", "REQUIRED", "FORBIDDEN"] }
      }
    },
    "profileContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_type", "profile_id", "profile_version", "schema_id", "schema_version", "profile_path", "record_type"],
      "properties": {
        "profile_type": { "enum": ["VALIDATION_RULE_PROFILE", "EXPERIMENT_PROFILE", "EXTENSION_REGISTRY", "SOURCE_SCHEMA_REGISTRY", "ROLE_VISIBILITY_PROFILE", "NORMALIZATION_PROFILE", "CLASSIFIER_FEATURE_PROFILE", "PREDICATE_APPLICABILITY_PROFILE", "ARM_INPUT_PROFILE", "AUTHORITY_PROFILE", "SETTLEMENT_PROFILE", "PROJECTION_PROFILE", "TRUST_ROOT_PROFILE", "VERIFIER_PROFILE", "CANONICALIZATION_PROFILE"] },
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_version": { "type": "string", "minLength": 1 },
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "profile_path": { "type": "string", "pattern": "^[^/]+(?:/[^/]+)*\\.json$" },
        "record_type": { "type": "string", "minLength": 1 },
        "selector": { "type": ["string", "null"] },
        "replaces_profile_version": { "type": ["string", "null"] }
      }
    },
    "canonicalizationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "schema_id", "schema_version", "profile_path"],
      "properties": {
        "profile_id": { "const": "urn:moirae:accord-02r5:canonicalization:rfc8785-jcs:0.1" },
        "profile_version": { "const": "0.1" },
        "schema_id": { "const": "urn:moirae:accord-02r5:schema:canonicalization-profile:0.1" },
        "schema_version": { "const": "0.1" },
        "profile_path": { "const": "examples/accord-02r5-canonicalization-profile.json" }
      }
    },
    "canonicalizationMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id", "container_type", "schema_id", "schema_version", "record_types", "canonicalization_profile_id", "canonicalization_profile_version", "content_target", "digest_algorithm", "digest_field", "digest_optional"],
      "properties": {
        "mapping_id": { "type": "string", "minLength": 1 },
        "container_type": { "enum": ["VERIFIER_RECORD_ENTRY", "EXPERIMENT_RECORD_ENTRY", "SCORER_ENTRY", "CANDIDATE_PROPOSITION_RECORD"] },
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "record_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "canonicalization_profile_id": { "const": "urn:moirae:accord-02r5:canonicalization:rfc8785-jcs:0.1" },
        "canonicalization_profile_version": { "const": "0.1" },
        "content_target": { "enum": ["content", "record_without_integrity_content_digest"] },
        "digest_algorithm": { "const": "SHA-256" },
        "digest_field": { "const": "integrity.content_digest" },
        "digest_optional": { "type": "boolean" }
      }
    },
    "ruleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_profile_id", "base_profile_version", "overlay_profile_id", "overlay_profile_version", "overlay_path", "dependency_graph_id", "dependency_graph_version", "dependency_graph_path", "composition", "override_policy"],
      "properties": {
        "base_profile_id": { "type": "string", "minLength": 1 },
        "base_profile_version": { "type": "string", "minLength": 1 },
        "overlay_profile_id": { "type": "string", "minLength": 1 },
        "overlay_profile_version": { "type": "string", "minLength": 1 },
        "overlay_path": { "type": "string", "pattern": "^[^/]+(?:/[^/]+)*\\.json$" },
        "dependency_graph_id": { "type": "string", "minLength": 1 },
        "dependency_graph_version": { "type": "string", "minLength": 1 },
        "dependency_graph_path": { "type": "string", "pattern": "^[^/]+(?:/[^/]+)*\\.json$" },
        "composition": { "const": "BASE_RULES_PLUS_EXPLICIT_OVERLAY" },
        "override_policy": { "const": "R4_BASE_HISTORY_PLUS_R5_EXPLICIT_CANDIDATE_OVERRIDES" }
      }
    },
    "referencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution_key", "missing_policy", "versionless_policy", "substitution_policy", "active_overrides"],
      "properties": {
        "resolution_key": { "const": ["profile_type", "profile_id", "profile_version"] },
        "missing_policy": { "const": "FAIL_VALIDATION" },
        "versionless_policy": { "const": "FAIL_VALIDATION" },
        "substitution_policy": { "const": "NO_LATEST_NO_CURRENT_NO_COMPATIBLE_SUBSTITUTION" },
        "active_overrides": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["old_profile_id", "old_profile_version", "new_profile_id", "new_profile_version"], "properties": { "old_profile_id": { "type": "string" }, "old_profile_version": { "type": "string" }, "new_profile_id": { "type": "string" }, "new_profile_version": { "type": "string" } } } }
      }
    }
  }
}
