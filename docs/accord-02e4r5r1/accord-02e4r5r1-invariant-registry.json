  "object_version": "0.2",
  "procedure_registry": {
    "SCHEMA_VALIDATE": {
      "arguments": {
        "instances": "SET<TYPED_REF>",
        "schemas": "SET<TYPED_REF>"
      },
      "resolution": "Resolve each reference exactly once and validate with Draft 2020-12.",
      "normalization": "NONE",
      "result": "BOOLEAN_CONJUNCTION",
      "missing": "FAIL",
      "ambiguity": "FAIL",
      "fail_closed": true
    },
    "REFERENCE_RESOLVE_ALL": {
      "arguments": {
        "registry": "TYPED_REF",
        "reference_model": "TYPED_REF"
      },
      "resolution": "Discover references only by the normative shape predicate; each edge resolves exactly once by kind,id,version and member_id when present.",
      "normalization": "LEXICOGRAPHIC_EDGE_SET",
      "result": "unresolved and ambiguous sets are empty",
      "missing": "FAIL",
      "ambiguity": "FAIL",
      "fail_closed": true
    },
    "UNIQUE_KEY_OVER_COLLECTION": {
      "arguments": {
        "collection": "TYPED_REF",
        "key": "ARRAY<STRING>"
      },
      "resolution": "Project declared key over every member.",
      "normalization": "NONE",
      "result": "projected key cardinality equals member cardinality",
      "missing": "FAIL",
      "ambiguity": "FAIL",
      "fail_closed": true
    },
    "DIGEST_RECOMPUTE_EQUAL": {
      "arguments": {
        "sources": "SET<PATH_BINDING>",
        "canonicalization": "TYPED_REF"
      },
      "resolution": "Read source, RFC8785 canonicalize parsed JSON for semantic digest, hash raw bytes for byte digest when declared.",
      "normalization": "RFC8785_JCS",
      "result": "all recomputed digests equal bindings",
      "missing": "FAIL",
      "ambiguity": "FAIL",
      "fail_closed": true
    },
    "DERIVED_SET_EQUAL": {
      "arguments": {
        "left": "DERIVED_SET",
        "right": "DERIVED_SET"
      },
      "resolution": "Derive both sets from declared inputs.",
      "normalization": "SET",
      "result": "left equals right",
      "missing": "FAIL",
      "ambiguity": "FAIL",
      "fail_closed": true
    },
    "LINEAGE_VALIDATE": {
      "arguments": {
        "package": "TYPED_REF",
        "accepted_base": "TYPED_REF"
      },
      "resolution": "Check package identity/version/status, typed accepted-base binding and rejected revision chain.",
      "normalization": "NONE",
      "result": "all lineage predicates true",
      "missing": "FAIL",
      "ambiguity": "FAIL",
      "fail_closed": true
    },
    "REQUIREMENT_MAP_EVALUATE": {
      "arguments": {
        "target": "TYPED_REF",
        "evidence": "TYPED_REF",
        "policy": "TYPED_REF"
      },
      "resolution": "Evaluate exact tuple, inclusive interval, retention, freshness, allowed source/consistency, complete read and absence of same-target positive evidence.",
      "normalization": "RFC3339_UTC_AND_CANONICAL_SCOPE",
      "result": "NON_OCCURRENCE_SUPPORTED iff every requirement passes, else UNKNOWN",
      "missing": "FAIL",
      "ambiguity": "FAIL",
      "fail_closed": true
    },
    "POLICY_CLOSURE": {
      "arguments": {
        "policy": "TYPED_REF",
        "authority": "TYPED_REF"
      },
      "resolution": "Check explicit graph, same-effect direct predecessor, forbidden implicit transitivity and policy-owned outcomes.",
      "normalization": "SET",
      "result": "all policy closure predicates true",
      "missing": "FAIL",
      "ambiguity": "FAIL",
      "fail_closed": true
    },
    "AUTHORITY_COMPLETENESS": {
      "arguments": {
        "matrix": "TYPED_REF",
        "invariants": "TYPED_REF"
      },
      "resolution": "Every conformance rule has exactly one authority-bound or derived form and no inline expected; every derivation resolves exactly once.",
      "normalization": "NONE",
      "result": "all conformance rules complete",
      "missing": "FAIL",
      "ambiguity": "FAIL",
      "fail_closed": true
    }
  },
