{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moirae:accord-02r5r2:schema:accepted-source-bindings:0.2",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "schema_ref",
    "object_id",
    "object_version",
    "sources"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "type": "string",
      "minLength": 1
    },
    "schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "not": {
        "required": [
          "zzz"
        ]
      }
    }
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "member_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
